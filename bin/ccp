#!/usr/bin/env bash
# ccp — Claude Code Provider Switcher
# Seamlessly switch models and providers for Claude Code CLI.

set -e

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
PROVIDERS_DIR="${PROVIDERS_DIR:-$CLAUDE_DIR/providers}"
SETTINGS_FILE="${SETTINGS_FILE:-$CLAUDE_DIR/settings.json}"

# Resolve the repo checkout that holds registry/ and bridge/.
ccp_repo_dir() {
  if [ -n "${CCP_REPO_DIR:-}" ] && [ -d "$CCP_REPO_DIR/bridge" ]; then
    echo "$CCP_REPO_DIR"; return
  fi
  # Resolve symlinks before deriving the path. An installed `ccp` is normally a
  # symlink at ~/.local/bin/ccp, and BASH_SOURCE would otherwise point there,
  # whose parent has no bridge/ — the install would silently fall through to a
  # guessed checkout and edit the wrong tree (or nothing at all).
  local self="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1; then
    local resolved
    resolved=$(readlink -f "$self" 2>/dev/null || true)
    [ -n "$resolved" ] && self="$resolved"
  fi

  local c
  for c in \
    "$(cd "$(dirname "$self")/.." 2>/dev/null && pwd)" \
    "$HOME/code/claude-code-providers" \
    "$HOME/.claude-code-providers" \
    "$HOME/claude-code-providers"; do
    if [ -d "$c/bridge" ]; then echo "$c"; return; fi
  done
}

# Prefer the litellm venv python (has pyyaml + litellm); fall back to python3.
ccp_python() {
  if [ -x "$HOME/.local/share/litellm-venv/bin/python3" ]; then
    echo "$HOME/.local/share/litellm-venv/bin/python3"
  else
    command -v python3
  fi
}

show_help() {
  cat <<'EOF'
ccp — Claude Code Provider & Model Switcher

Usage:
  ccp                        List all available providers (* marks active)
  ccp <provider> [model]     Switch provider (and optionally override model)
  ccp -m, --model <model>    Switch model within the current active provider
  ccp -c, --current          Show currently active provider, model, and endpoints
  ccp -r, --rollback [N]     Roll back to the Nth most recent backup (default: 1)
  ccp restore                Return Claude Code to its pre-ccp settings and stop
                             the local bridges (alias: ccp reset; options:
                             --dry-run, --yes, --keep-services, --strip, --from FILE)
  ccp -t, --test [name]      Quick test: send a ping through Claude Code
  ccp ping [provider|model]  Probe model health, TTFT & token speed (options:
                             -q/--quick, -b/--bench, -n/--rounds, --tokens, --sort,
                             --timeout, -s/--switch,
                             --agent: time to the first tool call, not the first token)
  ccp models [provider]      List models with context / output cap / vision
  ccp render                 Regenerate config + profiles from the registry
  ccp discover [provider]    Refresh model metadata from provider APIs
  ccp sync                   Sync local profiles with repository templates
  ccp bridge [action]        Manage local bridge: status, restart, start, stop,
                             deploy, logs, start-trae/stop-trae/restart-trae (the Trae adapter)
  ccp auth [copilot|trae]
                             Authenticate a provider (Copilot device flow, the
                             TraeCLI personal access token, or the WorkBuddy /
                             CodeBuddy Code session)
  ccp accounts [action]      Several logins for one provider, and routing groups:
                             list | add <provider> <suffix> | remove <provider> <suffix>
                             | group add <name> <member...> | group remove <name>
                             (a pool fails over natively when a quota runs out)
  ccp quota [provider]       What is left on each plan
  ccp usage                  Tokens actually spent, from the bridge's ledger
  ccp doctor                 Is this machine still consistent with the repository?
                             (--today, --days N, --by-model, --by-provider, --json)
  ccp hermes [provider]      Point the local Hermes agent at a provider's model.
                             Bare `ccp hermes` shows what it runs now. Writes
                             ~/.hermes/profiles/<profile>/config.yaml and
                             restarts the gateway; options: --profile, --dry-run,
                             --json, --config
  ccp -h, --help             Show this help message

In-Session Model Hot-Switching:
  Inside a running Claude Code session, type /model to switch between Opus,
  Sonnet, and Haiku tiers mapped to your provider's top models!

Examples:
  ccp minimax                # Switch to MiniMax's default model (M3.1-Flash)
  ccp trae kimi-k3           # Switch provider and pick the model in one step
  ccp -m cline-glm-5.3       # Change the active model within the current provider
  ccp ping                   # 2-round sustained speed & stability test (~200 tokens)
  ccp ping -b                # Deep benchmark (3 rounds, ~1000 tokens, strict stress test)
  ccp ping -q                # Quick check (1 round, 64 tokens, fast health ping)
  ccp ping trae -s           # Benchmark Trae models and auto-switch to the winner
  ccp cline deepseek-v4.1-flash  # Switch to ClinePass Token Plan and its default model
  ccp auth trae              # Import the TraeCLI personal access token into the bridge
  ccp auth workbuddy         # Import the CodeBuddy Code session (log in with `codebuddy` once)
  ccp accounts add cline a2       # Name a second login, then `ccp render`
  ccp accounts group add daily cline-deepseek-v4.1-flash opendesign-deepseek-v4.1-flash
  ccp -m group/daily         # One name over several models; fails over when one runs out
  ccp hermes                 # What model the local Hermes bot is running
  ccp hermes codex           # Point the bot at codex's default model too

Note: CommandCode, GitHub Copilot, OpenCode and Antigravity are archived — see
docs/archived-providers.md. `ccp auth copilot` still runs the Copilot device
flow.

Directories:
  Profiles:  ~/.claude/providers/*.json
  Active:    ~/.claude/settings.json
EOF
}

get_current_url() {
  if [ -f "$SETTINGS_FILE" ]; then
    grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$SETTINGS_FILE" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1
  fi
}

get_current_model() {
  if [ -f "$SETTINGS_FILE" ]; then
    grep -oE '"ANTHROPIC_MODEL"[^,]*' "$SETTINGS_FILE" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1
  fi
}

get_active_profile_name() {
  local cur_url cur_model
  cur_url=$(get_current_url)
  cur_model=$(get_current_model)
  if [ -z "$cur_url" ] && [ -z "$cur_model" ]; then
    return
  fi

  for p in "$PROVIDERS_DIR"/*.json; do
    [ -r "$p" ] || continue
    local p_url p_model
    p_url=$(grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$p" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
    p_model=$(grep -oE '"ANTHROPIC_MODEL"[^,]*' "$p" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
    if [ "$p_url" = "$cur_url" ]; then
      if [ "$p_model" = "$cur_model" ]; then
        basename "$p" .json
        return
      fi
    fi
  done

  # Fallback match by URL only
  for p in "$PROVIDERS_DIR"/*.json; do
    [ -r "$p" ] || continue
    local p_url
    p_url=$(grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$p" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
    if [ -n "$p_url" ] && [ "$p_url" = "$cur_url" ]; then
      basename "$p" .json
      return
    fi
  done
}

list_providers() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_pick.py" ]; then
    echo -e "\033[31mError: repo checkout not found (need bridge/ccp_pick.py).\033[0m" >&2
    return 1
  fi

  local active cur_model
  active=$(get_active_profile_name)
  cur_model=$(get_current_model)

  local folders
  folders=$("$(ccp_python)" "$repo_dir/bridge/ccp_pick.py" folders) || return 1
  [ -n "$folders" ] || { echo "No provider profiles found."; return 1; }

  local name kind count default ctx
  while IFS='|' read -r name kind count default ctx; do
    [ -n "$name" ] || continue
    if [ "$name" = "$active" ]; then
      printf " \033[32m* %-14s\033[0m %-8s %2s models   active: %s\n" \
        "$name/" "$kind" "$count" "${cur_model:-$default}"
    else
      printf "   %-14s %-8s %2s models   %s\n" "$name/" "$kind" "$count" "$default"
    fi
  done <<< "$folders"

  cat <<'EOF'

Each provider is a folder; its models are the contents.

  ccp <provider>              switch to that provider's default model
  ccp <provider> <model>      switch to a specific model  (also: ccp <p>/<model>)
  ccp models <provider>       just list a provider's models, change nothing
EOF
}

list_provider_models() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_pick.py" ]; then
    echo -e "\033[31mError: repo checkout not found (need bridge/ccp_pick.py).\033[0m" >&2
    return 1
  fi
  "$(ccp_python)" "$repo_dir/bridge/ccp_pick.py" list "$1"
}

show_current() {
  local active url model
  active=$(get_active_profile_name)
  url=$(get_current_url)
  model=$(get_current_model)

  echo "Current Claude Code Settings:"
  if [ -n "$active" ]; then
    echo "  Profile:  $active"
  else
    echo "  Profile:  (custom / unmapped)"
  fi
  echo "  Base URL: ${url:-default (Anthropic official)}"
  echo "  Model:    ${model:-default}"
}

rollback_backup() {
  local n="${1:-1}"
  local bak
  bak=$(ls -1t "$SETTINGS_FILE".bak.* 2>/dev/null | sed -n "${n}p")
  if [ -n "$bak" ]; then
    cp "$bak" "$SETTINGS_FILE"
    echo "Rolled back settings.json to backup: $bak"
  else
    echo "No backups available to roll back."
  fi
}

# Where `switch_provider` keeps the settings.json it found before the first
# replace. ccp overwrites the whole file per provider, so this snapshot is the
# only exact way back to the user's pre-ccp configuration.
SETTINGS_SNAPSHOT="${SETTINGS_FILE}.ccp-original"

# A ccp-rendered profile always carries the Fable tier, and nothing else does.
# `render_config.py` writes `ANTHROPIC_DEFAULT_FABLE_MODEL` into every profile
# it emits, unconditionally; it is the only key in the tier map that a file
# written before ccp existed never had.
#
# Deliberately NOT part of this test:
#   * `ANTHROPIC_BASE_URL` — the user may have configured the same gateway
#     themselves before installing ccp; that file is still "original".
#   * `CLAUDE_CODE_AUTO_COMPACT_WINDOW` — this one was in the user's own
#     hand-written settings long before ccp (measured here 2026-10-23: it
#     appears in all 20 pre-ccp backups and in all 93 ccp-rendered ones).
#     Treating it as a ccp fingerprint classified every original as ccp-made,
#     so `capture_pristine_settings` refused every file and the snapshot was
#     never taken, and `restore` reported "No pre-ccp settings found" while
#     holding 113 backups.
#
# Older ccp builds (before the Fable tier existed) wrote no such marker, but
# they did write a provider profile pointed at ccp's own loopback bridges. A
# file that points at a bridge ccp renders is not "original" whatever else it
# says: restoring it would leave the user aimed at a bridge that `restore`
# itself just stopped. That is a second, independent signal rather than a
# looser regex, so a self-configured third-party gateway still counts as the
# user's own.
CCP_LOOPBACK_RE='(127\.0\.0\.1|localhost):(4000|4001|4100)'

is_ccp_managed_settings() {
  [ -f "$1" ] || return 1
  grep -qE '"ANTHROPIC_DEFAULT_FABLE_MODEL"' "$1" 2>/dev/null && return 0
  grep -qE '"ANTHROPIC_BASE_URL"[[:space:]]*:[[:space:]]*"http://'"$CCP_LOOPBACK_RE"'"' "$1" 2>/dev/null && return 0
  return 1
}

# Called before ccp replaces settings.json. Never overwrites an existing
# snapshot and never captures a file ccp itself rendered.
capture_pristine_settings() {
  [ -f "$SETTINGS_FILE" ] || return 0
  [ -f "$SETTINGS_SNAPSHOT" ] && return 0
  is_ccp_managed_settings "$SETTINGS_FILE" && return 0
  if cp "$SETTINGS_FILE" "$SETTINGS_SNAPSHOT"; then
    chmod 600 "$SETTINGS_SNAPSHOT"  # settings.json can hold a token
  fi
}

# Existing installs predate the snapshot. Their first switch did leave a
# timestamped backup, so the oldest backup that is not ccp-rendered is the
# best available "original".
oldest_pristine_backup() {
  local bak
  # compgen keeps the glob safe when nothing matches; backup names carry a
  # timestamp, so lexical order is also chronological.
  while IFS= read -r bak; do
    [ -n "$bak" ] || continue
    if ! is_ccp_managed_settings "$bak"; then
      printf '%s\n' "$bak"
      return 0
    fi
  done < <(compgen -G "$SETTINGS_FILE.bak.*" | sort)
  return 1
}

# Remove only the keys ccp injects; everything else in settings.json (permissions,
# hooks, statusLine, ...) is the user's and must survive.
strip_ccp_settings() {
  local src="$1" dst="$2"
  if command -v jq >/dev/null 2>&1; then
    jq 'del(.model)
        | del(.env.ANTHROPIC_BASE_URL,
              .env.ANTHROPIC_AUTH_TOKEN,
              .env.ANTHROPIC_MODEL,
              .env.ANTHROPIC_DEFAULT_OPUS_MODEL,
              .env.ANTHROPIC_DEFAULT_FABLE_MODEL,
              .env.ANTHROPIC_DEFAULT_SONNET_MODEL,
              .env.ANTHROPIC_DEFAULT_HAIKU_MODEL,
              .env.ANTHROPIC_SMALL_FAST_MODEL,
              .env.CLAUDE_CODE_MAX_CONTEXT_TOKENS,
              .env.CLAUDE_CODE_AUTO_COMPACT_WINDOW)' "$src" > "$dst"
    return
  fi
  python3 - "$src" "$dst" <<'PY'
import json, sys

src, dst = sys.argv[1], sys.argv[2]
with open(src, encoding="utf-8") as fh:
    data = json.load(fh)

data.pop("model", None)
env = data.get("env")
if isinstance(env, dict):
    for key in (
        "ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_MODEL",
        "ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_DEFAULT_FABLE_MODEL",
        "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL",
        "ANTHROPIC_SMALL_FAST_MODEL", "CLAUDE_CODE_MAX_CONTEXT_TOKENS",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
    ):
        env.pop(key, None)
    if not env:
        data.pop("env", None)

with open(dst, "w", encoding="utf-8") as fh:
    json.dump(data, fh, ensure_ascii=False, indent=2)
    fh.write("\n")
PY
}

restore_original() {
  local dry_run=0 assume_yes=0 keep_services=0 strip=0 from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1 ;;
      -y|--yes) assume_yes=1 ;;
      --keep-services) keep_services=1 ;;
      --strip) strip=1 ;;
      --from)
        shift
        from="${1:-}"
        [ -n "$from" ] || { echo "--from needs a file" >&2; return 2; }
        ;;
      -h|--help)
        echo "Usage: ccp restore [--dry-run] [--yes] [--keep-services] [--strip] [--from FILE]"
        echo "  Restore settings.json to its pre-ccp state and stop the local bridges."
        echo "  --dry-run        Show what would change without touching anything"
        echo "  --yes            Do not ask for confirmation"
        echo "  --keep-services  Restore settings but leave litellm/watchdog/trae running"
        echo "  --strip          No pristine copy? Remove ccp keys from the current settings"
        echo "  --from FILE      Restore a specific backup instead of the snapshot"
        return 0
        ;;
      *) echo "Unknown option: $1" >&2; return 2 ;;
    esac
    shift
  done

  local src="" how=""
  if [ -n "$from" ]; then
    [ -r "$from" ] || { echo "Cannot read $from" >&2; return 1; }
    src="$from"
    how="explicit file"
  elif [ -f "$SETTINGS_SNAPSHOT" ]; then
    src="$SETTINGS_SNAPSHOT"
    how="pre-ccp snapshot"
  elif src=$(oldest_pristine_backup); then
    how="oldest non-ccp backup"
  elif [ "$strip" = 1 ]; then
    how="strip ccp keys from the current settings"
  else
    echo "No pre-ccp settings found." >&2
    echo "  Looked for: $SETTINGS_SNAPSHOT and non-ccp $SETTINGS_FILE.bak.*" >&2
    echo "  If the current file is the only one, run: ccp restore --strip" >&2
    echo "  Nothing was changed." >&2
    return 1
  fi

  echo "Restore plan:"
  echo "  Settings: ${SETTINGS_FILE}"
  if [ "$how" = "strip ccp keys from the current settings" ]; then
    echo "  Source:   (in place; ccp-injected keys removed)"
  else
    echo "  Source:   $src ($how)"
  fi
  # A settings.json carrying no credential is only usable if the user is
  # signed in to claude.ai instead (OAuth keeps its token elsewhere). Saying so
  # matters precisely now: with the marker fixed, `restore` can pick the oldest
  # backup — which on this machine predates every provider key, and restoring it
  # without a word would leave Claude Code unable to authenticate.
  if [ "$how" != "strip ccp keys from the current settings" ] \
     && ! grep -qE '"(ANTHROPIC_AUTH_TOKEN|ANTHROPIC_API_KEY)"' "$src" 2>/dev/null; then
    echo -e "  \033[33m⚠ This source carries no API key or auth token.\033[0m"
    echo "    It only works if Claude Code is signed in to claude.ai (OAuth)."
    echo "    Pick a later backup with --from, or use --strip to keep the current one."
  fi
  if [ "$keep_services" = 1 ]; then
    echo "  Services: keep running"
  else
    echo "  Services: stop + disable litellm-ccp, ccp-sse-watchdog, ccp-trae-bridge"
  fi

  if [ "$dry_run" = 1 ]; then
    echo "Dry run — nothing changed."
    return 0
  fi

  if [ "$assume_yes" != 1 ]; then
    local answer=""
    read -r -p "Proceed? [y/N] " answer || answer=""
    case "$answer" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; return 1 ;;
    esac
  fi

  mkdir -p "$CLAUDE_DIR"
  # Keep what we are about to replace, exactly like a provider switch does.
  if [ -f "$SETTINGS_FILE" ]; then
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.bak.$(date +%Y%m%d-%H%M%S)"
  fi

  if [ "$how" = "strip ccp keys from the current settings" ]; then
    local tmp
    tmp=$(mktemp)
    if ! strip_ccp_settings "$SETTINGS_FILE" "$tmp"; then
      rm -f "$tmp"
      echo "Failed to rewrite $SETTINGS_FILE" >&2
      return 1
    fi
    mv "$tmp" "$SETTINGS_FILE"
  else
    cp "$src" "$SETTINGS_FILE"
  fi
  chmod 600 "$SETTINGS_FILE"

  if [ "$keep_services" != 1 ]; then
    local unit
    for unit in litellm-ccp.service ccp-sse-watchdog.service ccp-trae-bridge.service; do
      systemctl --user stop "$unit" 2>/dev/null || true
      systemctl --user disable "$unit" 2>/dev/null || true
    done
  fi

  echo -e "\033[32m✔ Restored Claude Code settings from $how\033[0m"
  show_current
  if [ "$keep_services" != 1 ]; then
    echo "  Bridges stopped and disabled (re-enable with: ccp bridge start)."
  fi
}

set_active_model() {
  local model="$1"
  if [ -z "$model" ]; then
    echo "Error: model name required. Usage: ccp -m <model_name>" >&2
    return 1
  fi

  # `ccp -m group/daily` is the documented spelling of a routing group, but
  # LiteLLM reads a `/` in a model name as a provider prefix: it answers
  # `Invalid model name passed in model=group/daily` and the session dies with
  # a 400. render_config.py registers the group under its bare name, so drop
  # the prefix here and let both spellings work.
  case "$model" in
    group/*) model="${model#group/}" ;;
  esac

  if [ ! -f "$SETTINGS_FILE" ]; then
    echo "Error: settings file $SETTINGS_FILE not found. Switch to a provider first." >&2
    return 1
  fi

  # ctx is passed when the caller knows the model's real context window:
  # CLAUDE_CODE_MAX_CONTEXT_TOKENS is per-profile, so switching to a smaller
  # model must not leave the old number advertised or Claude Code will ask for
  # a window the model cannot honour.
  local ctx="${2:-}"

  if command -v jq >/dev/null 2>&1; then
    local tmp
    tmp=$(mktemp)
    if [ -n "$ctx" ]; then
      jq --arg m "$model" --argjson c "$ctx" '
        .model = $m |
        .env.ANTHROPIC_MODEL = $m |
        .env.CLAUDE_CODE_MAX_CONTEXT_TOKENS = ($c | tostring)
      ' "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"
    else
      jq --arg m "$model" '
        .model = $m |
        .env.ANTHROPIC_MODEL = $m
      ' "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"
    fi
  else
    sed -i -E "s/\"ANTHROPIC_MODEL\": \"[^\"]+\"/\"ANTHROPIC_MODEL\": \"$model\"/" "$SETTINGS_FILE"
    sed -i -E "s/\"model\": \"[^\"]+\"/\"model\": \"$model\"/" "$SETTINGS_FILE"
    if [ -n "$ctx" ]; then
      sed -i -E "s/\"CLAUDE_CODE_MAX_CONTEXT_TOKENS\": \"[^\"]+\"/\"CLAUDE_CODE_MAX_CONTEXT_TOKENS\": \"$ctx\"/" "$SETTINGS_FILE"
    fi
  fi

  echo -e "\033[32m✔ Active model updated to: $model\033[0m"
  echo "Restart any active 'claude' interactive sessions to take effect."
}

check_bridge_port() {
  local port="$1"
  timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/$port" 2>/dev/null
}

# Is the bridge actually serving, or merely listening?
#
# An open port proves something accepted a connection; it does not prove the
# thing behind it answers. LiteLLM can hold :4001 and return 500 to every
# request, and the watchdog can hold :4000 while its own call upstream is
# being answered by the HTTP proxy — the request leaves the machine, the
# proxy cannot route a loopback destination, and it replies 502 with an
# empty body. The symptom in both cases is the same: the bridge "is down"
# while the process is healthy. So the check asks the bridge, the way a
# client does: over the loopback, with no proxy in between.
#
# /health is not the endpoint for this — LiteLLM answers it with a 500 of
# its own on this installation. /v1/models is free, needs no model call,
# and still proves that the watchdog forwards, that LiteLLM is up and that
# it loaded a config.
bridge_health() {
  local url="$1"
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 --noproxy '*' \
          -H "Authorization: Bearer sk-ccp-litellm-local" \
          "$url/v1/models" 2>/dev/null) || code=""
  [ "$code" = "200" ]
}

# A loopback request that the proxy answers for comes back 502 with an empty
# body. ccp's own tools now keep the loopback out of the proxy, but anything
# else in the shell — Claude Code itself, curl, python — still reads
# `no_proxy`, and the wildcard spellings Windows hands down (`127.*`) mean
# nothing to them. Say so once, here, where the user is about to trust the
# bridge.
warn_if_loopback_proxied() {
  local np="${no_proxy:-${NO_PROXY:-}}"
  [ -n "$np" ] || return 0
  case ",${np}," in
    *",127.0.0.1,"*) return 0 ;;
  esac
  echo -e "  \033[33m⚠ no_proxy has no exact 127.0.0.1 entry ('${np}').\033[0m" >&2
  echo -e "    \033[33mTools that read it (Claude Code, curl, python) will send\033[0m" >&2
  echo -e "    \033[33mloopback calls to the proxy and get an empty 502.\033[0m" >&2
  echo -e "    \033[33mFix: export no_proxy=\"127.0.0.1,::1,localhost,\$no_proxy\"\033[0m" >&2
}

sync_proxy_env() {
  local cfg_dir="$HOME/.config/litellm"
  local env_file="$cfg_dir/proxy.env"
  local proxy_url="${https_proxy:-${http_proxy:-${HTTPS_PROXY:-${HTTP_PROXY:-}}}}"

  if [ -z "$proxy_url" ]; then
    for p in 7897 7899 7892; do
      if timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/$p" 2>/dev/null; then
        proxy_url="http://127.0.0.1:$p"
        break
      fi
    done
  fi

  # render_config.py emits `api_key: os.environ/<PROVIDER>_API_KEY`, so the
  # credential lines in proxy.env are load-bearing. Only (re)write the proxy
  # vars here and carry every other line over verbatim — a plain `cat >` used
  # to truncate the file and silently wipe every *_API_KEY on each run.
  local keep=""
  if [ -f "$env_file" ]; then
    keep=$(grep -viE '^[[:space:]]*(https?_proxy|no_proxy)[[:space:]]*=' "$env_file" || true)
  fi

  # The bypass list belongs to bridge/loopback.py: it knows the hosts a proxy
  # cannot serve — the loopback, and a relay that answers another caller's
  # question when the request goes through the proxy at all. The list that is
  # already in the file is merged in, so a host added by hand survives the
  # next run instead of being replaced by the default.
  local no_proxy_list old_no_proxy repo_dir py_bin
  repo_dir=$(ccp_repo_dir)
  py_bin=$(ccp_python)
  old_no_proxy=""
  if [ -f "$env_file" ]; then
    old_no_proxy=$(grep -iE '^[[:space:]]*no_proxy[[:space:]]*=' "$env_file" | head -1 \
      | cut -d= -f2- | tr -d '"'"'"' \r' || true)
  fi
  no_proxy_list="$("$py_bin" "$repo_dir/bridge/loopback.py" "$old_no_proxy" 2>/dev/null || true)"
  [ -n "$no_proxy_list" ] || no_proxy_list="localhost,127.0.0.1,::1,.local"

  if [ -n "$proxy_url" ] || [ -n "$keep" ]; then
    mkdir -p "$cfg_dir"
    local tmp
    tmp=$(mktemp)
    if [ -n "$proxy_url" ]; then
      cat >> "$tmp" <<EOF
http_proxy=$proxy_url
https_proxy=$proxy_url
HTTP_PROXY=$proxy_url
HTTPS_PROXY=$proxy_url
no_proxy=$no_proxy_list
NO_PROXY=$no_proxy_list
EOF
    fi
    [ -n "$keep" ] && printf '%s\n' "$keep" >> "$tmp"
    mv "$tmp" "$env_file"
  fi
}

ensure_bridge_running() {
  local url="$1"
  if [[ "$url" =~ (127\.0\.0\.1|localhost):4000 ]]; then
    sync_proxy_env
    warn_if_loopback_proxied
    local p4000=0 p4001=0
    check_bridge_port 4000 && p4000=1
    check_bridge_port 4001 && p4001=1

    if [ "$p4000" -eq 0 ] || [ "$p4001" -eq 0 ]; then
      echo -e "  \033[33m⚡ Universal Bridge (:4000 -> :4001) not running. Auto-starting...\033[0m"
      systemctl --user start litellm-ccp.service ccp-sse-watchdog.service 2>/dev/null || true
      for _ in {1..10}; do
        sleep 0.5
        check_bridge_port 4000 && p4000=1
        check_bridge_port 4001 && p4001=1
        [ "$p4000" -eq 1 ] && [ "$p4001" -eq 1 ] && break
      done
      if [ "$p4000" -eq 1 ] && [ "$p4001" -eq 1 ]; then
        echo -e "  \033[32m✔ Universal Bridge active (SSE Watchdog :4000 -> LiteLLM :4001)\033[0m"
      else
        echo -e "  \033[31m⚠ Notice: Bridge services could not be reached. Run 'ccp bridge restart'\033[0m"
      fi
    elif bridge_health "http://127.0.0.1:4000"; then
      echo -e "  \033[32m✔ Universal Bridge healthy (SSE Watchdog :4000 -> LiteLLM :4001)\033[0m"
    else
      # Both ports answer, the bridge does not. Say which half is broken
      # instead of claiming the whole thing is healthy.
      if bridge_health "http://127.0.0.1:4001"; then
        echo -e "  \033[31m✖ LiteLLM (:4001) serves, but the watchdog (:4000) does not answer.\033[0m" >&2
      else
        echo -e "  \033[31m✖ Universal Bridge is listening but not serving (LiteLLM :4001 does not answer).\033[0m" >&2
      fi
      echo -e "    \033[31mRun 'ccp bridge restart' and check: systemctl --user status litellm-ccp.service\033[0m" >&2
    fi
  fi

  # Trae is a separate, self-contained adapter on :4100 — it speaks Anthropic
  # itself, so it never touches LiteLLM or the watchdog. Same auto-start
  # contract as the universal bridge so `ccp trae` works from a cold shell.
  if [[ "$url" =~ (127\.0\.0\.1|localhost):4100 ]]; then
    sync_proxy_env
    warn_if_loopback_proxied
    if check_bridge_port 4100; then
      echo -e "  \033[32m✔ Trae bridge healthy (:4100)\033[0m"
      return 0
    fi
    echo -e "  \033[33m⚡ Trae bridge (:4100) not running. Auto-starting...\033[0m"
    if systemctl --user start ccp-trae-bridge.service 2>/dev/null; then
      for _ in {1..10}; do
        sleep 0.5
        check_bridge_port 4100 && break
      done
    fi
    if check_bridge_port 4100; then
      echo -e "  \033[32m✔ Trae bridge active (:4100)\033[0m"
    elif [ ! -f "$HOME/.config/systemd/user/ccp-trae-bridge.service" ]; then
      echo -e "  \033[33m⚠ No service installed. Run this once:\033[0m"
      echo -e "      cp \$(ccp_repo_dir)/bridge/ccp-trae-bridge.service.example \\"
      echo -e "         \$HOME/.config/systemd/user/ccp-trae-bridge.service"
      echo -e "      systemctl --user daemon-reload && systemctl --user enable --now ccp-trae-bridge.service"
    else
      echo -e "  \033[31m⚠ Trae bridge failed to start: systemctl --user status ccp-trae-bridge.service\033[0m"
    fi
  fi
}

# Copy the freshly rendered bridge config into service, because `ccp render`
# only writes bridge/config.generated.yaml. Without this step `ccp render` +
# `ccp bridge restart` silently kept serving the previous model list — a new
# provider (or a corrected clamp map) looked like it had no effect.
# setup_bridge.sh performs the same copy on install.
deploy_bridge_config() {
  local repo_dir src dst
  repo_dir=$(ccp_repo_dir)
  src="$repo_dir/bridge/config.generated.yaml"
  dst="$HOME/.config/litellm/config.yaml"
  [ -n "$repo_dir" ] && [ -f "$src" ] || return 0

  # The watchdog reads bridge/clamp_map.json and bridge/request_rules.json
  # straight out of the checkout, so only the LiteLLM config needs deploying.
  if [ -f "$dst" ] && cmp -s "$src" "$dst"; then
    return 0
  fi

  if [ -f "$dst" ]; then
    # A hand-edited config.yaml can hold literal api_key values, which
    # setup_bridge.sh migrates into proxy.env. Never drop those on the floor.
    if grep -E '^[[:space:]]*api_key:' "$dst" 2>/dev/null | grep -qv 'os.environ/'; then
      echo -e "  \033[33m⚠ $dst contains literal api_key values — not overwriting.\033[0m"
      echo "    Run 'bash bridge/setup_bridge.sh' to migrate them into proxy.env first."
      return 0
    fi
    cp "$dst" "$dst.bak.$(date +%Y%m%d-%H%M%S)"
  fi

  mkdir -p "$(dirname "$dst")"
  if cp "$src" "$dst"; then
    echo -e "  \033[32m✔ Deployed bridge config -> $dst\033[0m"
  else
    echo -e "  \033[31m! Failed to deploy bridge config to $dst\033[0m" >&2
    return 1
  fi
}

manage_bridge() {
  local action="${1:-status}"
  case "$action" in
    start-trae|stop-trae|restart-trae)
      # Addresses the Trae adapter only. It deliberately does NOT deploy
      # config.generated.yaml: the adapter needs no LiteLLM config, and pushing
      # one here would touch the running universal bridge for no benefit.
      #
      # The adapter is independent of LiteLLM: its own process on its own port,
      # driven by a local CLI. (opencode and agy were the same shape and are
      # archived — see docs/archived-providers.md.)
      local adapter="${action#*-}" adapter="${adapter%-*}"  # strip verb, strip suffix
      case "$adapter" in
        trae)     unit=ccp-trae-bridge.service;     port=4100; label=Trae ;;
        *) echo "Unknown adapter '$adapter'." >&2; return 1 ;;
      esac
      systemctl --user "${action%%-*}" "$unit" 2>/dev/null || {
        echo -e "\033[31mNo $unit installed. See README → $label.\033[0m" >&2
        return 1
      }
      sleep 1
      if check_bridge_port "$port"; then
        echo -e "\033[32m✔ $label bridge active (:$port)\033[0m"
      else
        echo -e "\033[31m✗ $label bridge down — systemctl --user status $unit\033[0m"
      fi
      ;;
    status)
      echo "Universal Bridge Status:"
      local p4000=0 p4001=0
      check_bridge_port 4000 && p4000=1
      check_bridge_port 4001 && p4001=1

      if [ "$p4000" -eq 1 ]; then
        echo -e "  Watchdog (:4000):   \033[32mRUNNING\033[0m"
      else
        echo -e "  Watchdog (:4000):   \033[31mSTOPPED\033[0m"
      fi

      if [ "$p4001" -eq 1 ]; then
        echo -e "  LiteLLM  (:4001):   \033[32mRUNNING\033[0m"
      else
        echo -e "  LiteLLM  (:4001):   \033[31mSTOPPED\033[0m"
      fi

      # The adapter is independent of the above two — it does not go through
      # LiteLLM — so report it separately rather than implying the universal
      # bridge covers it.
      if check_bridge_port 4100; then
        echo -e "  Trae     (:4100):   \033[32mRUNNING\033[0m"
      else
        echo -e "  Trae     (:4100):   \033[31mSTOPPED\033[0m  (ccp auth trae; ccp bridge start-trae)"
      fi
      ;;
    restart)
      echo "Restarting bridge services..."
      deploy_bridge_config
      sync_proxy_env
      systemctl --user restart litellm-ccp.service 2>/dev/null || true
      sleep 1.5
      systemctl --user restart ccp-sse-watchdog.service 2>/dev/null || true
      for u in ccp-trae-bridge; do
        systemctl --user restart "$u.service" 2>/dev/null || true
      done
      sleep 0.5
      manage_bridge status
      ;;
    start)
      echo "Starting bridge services..."
      deploy_bridge_config
      sync_proxy_env
      systemctl --user start litellm-ccp.service ccp-sse-watchdog.service 2>/dev/null || true
      # Adapters, where installed: each is optional and independent, so a
      # unit that was never installed must not fail the whole start.
      for u in ccp-trae-bridge; do
        systemctl --user start "$u.service" 2>/dev/null || true
      done
      sleep 1
      manage_bridge status
      ;;
    deploy)
      deploy_bridge_config
      manage_bridge status
      ;;
    stop)
      echo "Stopping bridge services..."
      systemctl --user stop ccp-sse-watchdog.service litellm-ccp.service 2>/dev/null || true
      # Adapters stop too: they are listeners holding their own ports, and a
      # "stopped" bridge that is still answering is not stopped.
      for u in ccp-trae-bridge; do
        systemctl --user stop "$u.service" 2>/dev/null || true
      done
      manage_bridge status
      ;;
    logs)
      journalctl --user -u ccp-sse-watchdog.service -u litellm-ccp.service \
        -u ccp-trae-bridge.service -f -n 50
      ;;
    *)
      echo "Usage: ccp bridge [status|restart|start|stop|deploy|logs]"
      echo "       ccp bridge {start|stop|restart}-trae   # the local Trae adapter"
      ;;
  esac
}

auth_provider() {
  local target="${1:-copilot}"
  case "$target" in
    copilot|github-copilot|github)
      echo -e "\033[36m=== GitHub Copilot Authentication (Device Flow) ===\033[0m"
      local py_bin="$HOME/.local/share/litellm-venv/bin/python3"
      if [ ! -x "$py_bin" ]; then
        py_bin=$(command -v python3)
      fi
      if ! "$py_bin" -c "import litellm" 2>/dev/null; then
        echo -e "\033[31mError: litellm not found in $py_bin. Run bridge setup first: bash bridge/setup_bridge.sh\033[0m" >&2
        return 1
      fi

      export GITHUB_COPILOT_FORCE_LOGIN=1
      "$py_bin" -c '
import sys
from litellm.llms.github_copilot.authenticator import Authenticator

try:
    auth = Authenticator()
    token = auth.get_access_token()
    if token:
        print("\n\033[32m✔ Authentication successful! Copilot access token has been verified.\033[0m")
        print(f"Token file: {auth.access_token_file}")
        key = auth.get_api_key()
        if key:
            print(f"API key file: {auth.api_key_file}")
            print("\033[32m✔ Copilot session API key successfully refreshed!\033[0m")
except KeyboardInterrupt:
    print("\nAuthorization cancelled by user.")
    sys.exit(130)
except Exception as e:
    print(f"\n\033[31mAuthentication failed: {e}\033[0m", file=sys.stderr)
    sys.exit(1)
'
      local ret=$?
      if [ $ret -eq 0 ]; then
        echo ""
        echo -e "\033[32m✔ Copilot credentials ready!\033[0m"
        echo "Restart bridge:  ccp bridge restart"
        echo "Switch profile:  ccp copilot"
      fi
      return $ret
      ;;
    trae|traecli)
      # TraeCLI keeps its personal access token in ~/.bashrc rather than a
      # keychain. Copy it into the shared secrets file so the bridge works
      # without an interactive shell, then prove the subscription answers.
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/trae_auth.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/trae_auth.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)
      echo -e "\033[36m=== Trae Authentication (import TraeCLI token) ===\033[0m"
      "$py_bin" "$repo_dir/bridge/trae_auth.py" "${@:2}"
      return $?
      ;;
    workbuddy|codebuddy)
      # Retired with the provider: the importer is archived, and the gateway's
      # channel check refused real sessions often enough that the plan is not a
      # dependable route. Say so rather than run a stale copy.
      echo -e "\033[33mWorkBuddy / CodeBuddy was removed.\033[0m" >&2
      echo "  The importer and the measurement notes are in bridge/archived/ and" >&2
      echo "  docs/workbuddy-channel-check.md. For a provider that stays reachable:" >&2
      echo "  ccp - lists what is installed." >&2
      return 1
      ;;
    *)
      echo "Usage: ccp auth [copilot|trae]" >&2
      return 1
      ;;
  esac
}

render_registry() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ]; then
    echo -e "\033[31mError: repo checkout not found (need registry/ and bridge/).\033[0m" >&2
    echo "Set CCP_REPO_DIR or clone to ~/code/claude-code-providers" >&2
    return 1
  fi
  local py
  py=$(ccp_python)
  # --prune: delete the template of a profile that no longer exists. A stale
  # template keeps a dead profile alive — the audit that decides which
  # installed profiles are dead reads the templates as well as the running
  # bridge, so a leftover `minimax.json.example` still names MiniMax-M3.1-Flash
  # and the installed minimax profile is never flagged.
  "$py" "$repo_dir/bridge/render_config.py" --prune "$@"
}

discover_models() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ]; then
    echo -e "\033[31mError: repo checkout not found.\033[0m" >&2
    return 1
  fi
  local py
  py=$(ccp_python)
  echo "Refreshing model metadata from provider APIs..."
  "$py" "$repo_dir/bridge/discover_models.py" "$@"
}

show_models() {
  local filter="${1:-}"
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/registry/models.yaml" ]; then
    echo -e "\033[31mError: registry/models.yaml not found. Run 'ccp discover' first.\033[0m" >&2
    return 1
  fi
  local py
  py=$(ccp_python)
  local active_model
  active_model=$(get_current_model)
  "$py" - "$repo_dir/registry/models.yaml" "$repo_dir/registry/profiles.yaml" "$filter" "$active_model" <<'PY'
import sys, yaml
models_path, profiles_path, filt, active = sys.argv[1:5]
doc = yaml.safe_load(open(models_path)) or {}
try:
    prof = yaml.safe_load(open(profiles_path)) or {}
except Exception:
    prof = {}
# alias index: (provider, model) -> alias
aliases = {}
for a, s in (prof.get("aliases") or {}).items():
    aliases[(s["provider"], s["model"])] = a
exposed = set(prof.get("expose_models") or [])
PROV_ORDER = [p["name"] for p in doc.get("providers", [])]
def fmt_ctx(c):
    if not c: return "?"
    return f"{c//1000}k" if c < 1_000_000 else f"{c/1_000_000:.0f}M".replace(".0M","M")
for p in doc.get("providers", []):
    if filt and filt != p["name"]:
        continue
    # show every model for small providers, or when the user asked for one
    show_all = bool(filt) or len(p["models"]) <= 12
    print(f"\n\033[36m{p['name']}\033[0m ({p.get('endpoint_kind')}, {len(p['models'])} models)  {p.get('api_base','')}")
    print(f"  {'alias / model':40s} {'ctx':>6}  {'out':>7}  vis")
    for m in p["models"]:
        a = aliases.get((p["name"], m["name"]))
        name = a if a else m["name"]
        star = "\033[32m*\033[0m" if active and (active == name or active.split('[')[0] == name) else " "
        # only show curated/exposed models in the compact summary view
        if not show_all and not a and m["name"] not in exposed:
            continue
        vis = "yes" if m.get("vision") is True else ("no" if m.get("vision") is False else "-")
        out = m.get("max_output")
        print(f"{star} {name:40s} {fmt_ctx(m.get('ctx')):>6}  {str(out or '?'):>7}  {vis}")
    if not show_all:
        shown = sum(1 for m in p["models"] if aliases.get((p["name"],m["name"])) or m["name"] in exposed)
        if shown < len(p["models"]):
            print(f"    … {len(p['models']) - shown} more — run 'ccp models {p['name']}' to list all")
PY
}

# A profile installed from a template carries the template's placeholder
# credential (`YOUR_OPENDESIGN_API_KEY`): the repository must not carry a
# secret. The real one lives in proxy.env, so it is filled in here — a
# profile whose placeholder survived installation answers 401 and reads as a
# broken provider rather than as an unfinished install.
#
# proxy.env is the only source. A key the user revoked is gone from there,
# and it must not come back from an archived profile.
fill_placeholder_credential() {
  local base="$1" name="$2"
  local live="$PROVIDERS_DIR/$base"
  [ -f "$live" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local tok
  tok=$(jq -r '.env.ANTHROPIC_AUTH_TOKEN // empty' "$live" 2>/dev/null)
  case "$tok" in
    ""|YOUR_*) : ;;
    *) return 0 ;;  # a real credential is already there
  esac
  local repo_dir py_bin real
  repo_dir=$(ccp_repo_dir)
  py_bin=$(ccp_python)
  real=$("$py_bin" "$repo_dir/bridge/profile_credential.py" "$name" 2>/dev/null || true)
  if [ -z "$real" ]; then
    echo -e "  \033[33m! $name has no credential: put it in ~/.config/litellm/proxy.env as <PROVIDER>_API_KEY\033[0m" >&2
    return 0
  fi
  local tmp
  tmp=$(mktemp)
  if jq --arg t "$real" '.env.ANTHROPIC_AUTH_TOKEN = $t' "$live" > "$tmp" 2>/dev/null && mv "$tmp" "$live"; then
    echo -e "  \033[33m~ Filled $name's credential from proxy.env\033[0m"
  else
    rm -f "$tmp"
  fi
}

sync_providers() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)

  if [ -z "$repo_dir" ] || [ ! -d "$repo_dir/providers" ]; then
    echo -e "\033[31mError: repo providers directory not found.\033[0m" >&2
    echo "Set CCP_REPO_DIR or clone repo to ~/code/claude-code-providers or ~/.claude-code-providers" >&2
    return 1
  fi

  echo "Synchronizing profiles with repository templates ($repo_dir)..."
  mkdir -p "$PROVIDERS_DIR"
  mkdir -p "$CLAUDE_DIR/providers_disabled"

  # Archive the profiles that point at a model the bridge no longer serves.
  # The list is derived, not written by hand: a provider retired yesterday
  # is not on any hand-written list, and a hand-written list eventually
  # archives a provider that came back (it did: qianfan was on it while
  # qianfan was live). A profile for a provider that is gone is a landmine —
  # it is a valid file, the bridge is up, and the request only fails when
  # somebody selects it, with a 400 that reads like the bridge is down.
  local py_bin dead
  py_bin=$(ccp_python)
  dead=$("$py_bin" "$repo_dir/bridge/profile_audit.py" --dead --providers-dir "$PROVIDERS_DIR" 2>/dev/null)
  for obsolete in $dead; do
    [ -f "$PROVIDERS_DIR/$obsolete" ] || continue
    mv "$PROVIDERS_DIR/$obsolete" "$CLAUDE_DIR/providers_disabled/"
    echo -e "  \033[33m-- Archived dead profile $obsolete to ~/.claude/providers_disabled/\033[0m"
  done

  local added=0 reconciled=0
  for ex in "$repo_dir/providers"/*.json.example; do
    [ -f "$ex" ] || continue
    local base="$(basename "$ex" .example)"      # e.g. cmdc-vision.json
    local name="${base%.json}"                  # e.g. cmdc-vision
    if [ ! -f "$PROVIDERS_DIR/$base" ]; then
      cp "$ex" "$PROVIDERS_DIR/$base"
      echo -e "  \033[32m✔ Added new provider template: $base\033[0m"
      fill_placeholder_credential "$base" "$name"
      added=$((added + 1))
    else
      # Reconcile: refresh only the registry-derived context fields, keep
      # the user's own keys (tokens, extra settings) intact.
      reconcile_profile "$base" "$name" "$ex" && reconciled=$((reconciled + 1))
    fi
  done

  # The active profile is a copy of one of these, and it drifts the same way.
  if reconcile_active_settings; then
    reconciled=$((reconciled + 1))
  fi

  echo -e "\033[32m✔ Sync complete (added $added, reconciled $reconciled). Active providers:\033[0m"
  list_providers
}

# Merge registry-derived context fields from a template into a live profile,
# preserving the user's secrets and custom keys. Backs up before writing.
reconcile_profile() {
  local base="$1" name="$2" template="$3"
  local live="$PROVIDERS_DIR/$base"
  [ -f "$live" ] || return 1

  if ! command -v jq >/dev/null 2>&1; then
    return 1
  fi

  # Only proceed if a derived field actually changed.
  local new_ctx new_model cur_ctx cur_model new_token cur_token new_base cur_base bridge_key
  new_ctx=$(jq -r '.env.CLAUDE_CODE_MAX_CONTEXT_TOKENS // empty' "$template")
  new_model=$(jq -r '.env.ANTHROPIC_MODEL // empty' "$template")
  cur_ctx=$(jq -r '.env.CLAUDE_CODE_MAX_CONTEXT_TOKENS // empty' "$live")
  cur_model=$(jq -r '.env.ANTHROPIC_MODEL // empty' "$live")
  new_token=$(jq -r '.env.ANTHROPIC_AUTH_TOKEN // empty' "$template")
  cur_token=$(jq -r '.env.ANTHROPIC_AUTH_TOKEN // empty' "$live")
  new_base=$(jq -r '.env.ANTHROPIC_BASE_URL // empty' "$template")
  cur_base=$(jq -r '.env.ANTHROPIC_BASE_URL // empty' "$live")
  # The bridge's own key, read from the module that owns it: a native profile
  # that still carries it is carrying a leftover, not a credential.
  local repo_dir py_bin
  repo_dir=$(ccp_repo_dir)
  py_bin=$(ccp_python)
  bridge_key=$("$py_bin" -c "import sys; sys.path.insert(0, '$repo_dir/bridge'); from bridge_auth import MASTER_KEY; print(MASTER_KEY)" 2>/dev/null || true)

  # A bridged profile's ANTHROPIC_AUTH_TOKEN is the local bridge's master key,
  # not a vendor credential: `ccp render` writes it and it has to follow the
  # render. Keeping the live one is what breaks an upgrade — the key was
  # renamed from sk-cmdc-litellm-local to sk-ccp-litellm-local, and a profile
  # that kept the old token is refused with a 401 by a bridge that now expects
  # the new one, with nothing in the message to say which of the two is wrong.
  #
  # A native profile's token IS the vendor's key, and that one stays — with
  # one exception: a profile that used to point at the bridge and now points
  # at a vendor still carries the bridge's master key, and handing that to
  # the vendor is a 401 "Invalid credential". The token follows the base URL.
  local keep_filter="AUTH_TOKEN$|_API_KEY$" want_token="$cur_token"
  case "$new_base" in
    *:4000*|*:4001*)
      keep_filter="_API_KEY$"
      want_token="$new_token"
      ;;
    *)
      if [ -n "$bridge_key" ] && [ "$cur_token" = "$bridge_key" ]; then
        keep_filter="_API_KEY$"
        want_token="$new_token"
      fi
      ;;
  esac

  # The base URL is part of what can change: a provider that moves its
  # endpoint, or a profile that was installed against a wrong one, would
  # otherwise keep calling the old address forever — the request 404s and
  # nothing in the diff says why.
  #
  # So is every other derived field. Listing the ones that matter is a list
  # that is always one item short: a tier model that moved, a context window
  # that grew, a base URL that changed. The comparison is therefore the whole
  # environment, minus the credential keys whose handling is decided above.
  local merged="$live.merged.$$"
  if ! jq -s --arg re "$keep_filter" \
       '.[0] * {env: (.[0].env * (.[1].env | with_entries(select(.key|test($re)))))}' \
       "$template" "$live" > "$merged" 2>/dev/null; then
    rm -f "$merged"
    return 1
  fi
  # `del(.env | with_entries(...))` is not a valid jq path — it errors, both
  # sides of the diff come out empty, and every profile looks unchanged.
  # Filtering the env object itself is the correct spelling.
  if diff -q \
       <(jq -S --arg re "$keep_filter" '(.env) |= with_entries(select(.key|test($re)|not))' "$merged" 2>/dev/null) \
       <(jq -S --arg re "$keep_filter" '(.env) |= with_entries(select(.key|test($re)|not))' "$live" 2>/dev/null) >/dev/null 2>&1; then
    rm -f "$merged"
    return 1
  fi
  rm -f "$merged"

  cp "$live" "$live.bak.$(date +%Y%m%d-%H%M%S)"
  local tmp
  tmp=$(mktemp)
  # take template, then re-apply any user credential overrides
  # (match credential keys exactly: AUTH_TOKEN / API_KEY — NOT *_TOKENS counts)
  if jq -s --arg re "$keep_filter" \
       '.[0] * {env: (.[0].env * (.[1].env | with_entries(select(.key|test($re)))))}' \
       "$template" "$live" > "$tmp" 2>/dev/null && mv "$tmp" "$live"; then
    echo -e "  \033[33m~ Reconciled $name (ctx $cur_ctx -> $new_ctx)\033[0m"
    # A native profile whose token is the template's placeholder needs the
    # vendor's key: the template cannot carry a secret, and the bridge's key
    # is not the vendor's.
    case "$new_base" in
      *:4000*|*:4001*) : ;;
      *) fill_placeholder_credential "$base" "$name" ;;
    esac
    return 0
  fi
  rm -f "$tmp"
  echo -e "  \033[31m! Failed to reconcile $name (jq error)\033[0m" >&2
  return 1
}

# The live profile is what Claude Code actually reads, and it is a *copy* of a
# provider profile - so it drifts exactly the way a profile drifts. When the
# bridge's key was renamed, the copy kept the old one and every request failed
# with a 400 that named neither the key nor the bridge:
#
#   {"error":{"message":"No connected db.","type":"no_db_connection","code":"400"}}
#
# The bridge now forwards its own key whatever the client sends, so the call
# works anyway - but the config should still say what it means. A native
# profile's credential is the vendor's own and is never touched.
reconcile_active_settings() {
  local repo_dir py key base cur
  [ -f "$SETTINGS_FILE" ] || return 1
  command -v jq >/dev/null 2>&1 || return 1

  repo_dir=$(ccp_repo_dir)
  [ -n "$repo_dir" ] || return 1
  py=$(ccp_python)

  base=$(jq -r '.env.ANTHROPIC_BASE_URL // empty' "$SETTINGS_FILE" 2>/dev/null) || return 1
  case "$base" in
    *:4000*|*:4001*) ;;
    *) return 1 ;;
  esac

  # The credential LiteLLM enforces, read from the config it runs on.
  key=$("$py" "$repo_dir/bridge/bridge_auth.py" --print-master-key 2>/dev/null) || return 1
  [ -n "$key" ] || return 1

  cur=$(jq -r '.env.ANTHROPIC_AUTH_TOKEN // empty' "$SETTINGS_FILE")
  [ "$cur" = "$key" ] && return 1

  cp "$SETTINGS_FILE" "$SETTINGS_FILE.bak.$(date +%Y%m%d-%H%M%S)"
  local tmp
  tmp=$(mktemp)
  if jq --arg k "$key" '.env.ANTHROPIC_AUTH_TOKEN = $k' "$SETTINGS_FILE" > "$tmp" 2>/dev/null && mv "$tmp" "$SETTINGS_FILE"; then
    echo -e "  \033[33m~ Reconciled the active profile's bridge credential\033[0m"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

test_provider() {
  local name="${1:-}"
  if [ -n "$name" ]; then
    switch_provider "$name"
  fi
  local cur_url
  cur_url=$(get_current_url)
  if [[ "$cur_url" =~ (127\.0\.0\.1|localhost):4000 ]]; then
    ensure_bridge_running "$cur_url"
  fi
  echo "Testing provider with 'claude -p \"say pong\"'..."
  claude -p "say pong"
}

switch_provider() {
  local arg1="$1"
  local arg2="${2:-}"

  # `ccp trae/kimi-k3` is the folder-path spelling of `ccp trae kimi-k3`.
  local provider="$arg1" model="$arg2"
  case "$arg1" in
    */*) provider="${arg1%%/*}"; model="${arg1#*/}" ;;
  esac

  local repo_dir py
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_pick.py" ]; then
    echo -e "\033[31mError: repo checkout not found (need bridge/ccp_pick.py).\033[0m" >&2
    return 1
  fi
  py=$(ccp_python)

  # Resolve BEFORE touching settings.json: a typo must not leave the session
  # pointed at a model that does not exist.
  local resolved
  if ! resolved=$("$py" "$repo_dir/bridge/ccp_pick.py" resolve "$provider" "$model" 2>&1); then
    echo -e "\033[31m$resolved\033[0m" >&2
    return 1
  fi
  local wire_model wire_ctx
  wire_model=$(printf '%s\n' "$resolved" | sed -n 's/^MODEL=//p')
  wire_ctx=$(printf '%s\n' "$resolved" | sed -n 's/^CTX=//p')

  local src="$PROVIDERS_DIR/$provider.json"
  if [ ! -r "$src" ]; then
    echo -e "\033[31mError: no installed profile for provider '$provider'.\033[0m" >&2
    echo "Run 'ccp sync' to install the profiles, then retry." >&2
    return 1
  fi

  mkdir -p "$CLAUDE_DIR"
  # Remember the pre-ccp file before the first replace, so `ccp restore` has an
  # exact target rather than "whichever backup looks least provider-shaped".
  capture_pristine_settings
  if [ -f "$SETTINGS_FILE" ]; then
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.bak.$(date +%Y%m%d-%H%M%S)"
  fi

  # Always install the provider profile first — it carries the base URL, the
  # tier fallbacks and the credentials. Only the model line is overridden
  # afterwards, otherwise switching to `trae kimi-k3` from a cline session
  # would keep cline's URL.
  cp "$src" "$SETTINGS_FILE"
  if [ -n "$model" ]; then
    # A 200 and a completion are not proof: MiniMax answers a request for
    # MiniMax-M3.1 with one from M3. Check what actually served, and say so
    # rather than letting the session silently run a different model.
    if [ -z "$SKIP_VERIFY" ]; then
      local verdict
      # `set -e` is on: verify exits non-zero when the name is downgraded, and a
      # bare `verdict=$(...)` would abort the whole switch on that — which is
      # the opposite of what a warning should do. `|| true` keeps the verdict.
      verdict=$("$py" "$repo_dir/bridge/ccp_pick.py" verify "$provider" "$model" 2>/dev/null || true)
      # Fields are TAB-separated: MISMATCH <asked> <served>. Split with cut
      # rather than ${v%%TAB*} — a literal tab in this file is invisible and
      # gets eaten by editors and heredocs alike.
      local tag
      tag=$(printf '%s' "$verdict" | cut -f1)
      if [ "$tag" = "MISMATCH" ]; then
        local asked served
        asked=$(printf '%s' "$verdict" | cut -f2)
        served=$(printf '%s' "$verdict" | cut -f3)
        echo -e "\033[33m! $asked is not served here\033[0m" >&2
        echo -e "  the endpoint answered as \"$served\" instead." >&2
        echo -e "  Switching anyway; SKIP_VERIFY=1 silences this." >&2
      fi
    fi
    set_active_model "$wire_model" "$wire_ctx" >/dev/null
  fi

  local target_url
  target_url=$(grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$src" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
  [ -n "$target_url" ] && ensure_bridge_running "$target_url"

  echo -e "\033[32m✔ $provider → $wire_model\033[0m"
  echo "Restart any active 'claude' interactive sessions to take effect."
  list_provider_models "$provider"
}

main() {
  case "${1:-}" in
    "")
      list_providers
      ;;
    -h|--help|help)
      show_help
      ;;
    -c|--current|current)
      show_current
      ;;
    -r|--rollback|rollback)
      rollback_backup "${2:-1}"
      ;;
    restore|reset)
      restore_original "${@:2}"
      ;;
    -m|--model|model)
      set_active_model "${2:-}"
      ;;
    -t|--test|test)
      test_provider "${2:-}"
      ;;
    bridge)
      manage_bridge "${2:-status}"
      ;;
    hermes)
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/hermes_config.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/hermes_config.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)

      # The helper takes a verb; the command is spelled `ccp hermes [provider]`, so
      # the verb is put back here. A leading flag is a query about the profile
      # (`ccp hermes --profile x`), a leading word is the provider to point at.
      local -a hargs=("${@:2}")
      if [ "${#hargs[@]}" -eq 0 ]; then
        hargs=(status)
      else
        case "${hargs[0]}" in
          render|status) : ;;
          -*) hargs=(status "${hargs[@]}") ;;
          *)  hargs=(render "${hargs[@]}") ;;
        esac
      fi

      local tmp rc=0
      tmp=$(mktemp)
      "$py_bin" "$repo_dir/bridge/hermes_config.py" "${hargs[@]}" >"$tmp" || rc=$?
      cat "$tmp"
      if [ "$rc" -ne 0 ]; then
        rm -f "$tmp"
        return "$rc"
      fi

      local changed profile
      changed=$(sed -n 's/^CHANGED=//p' "$tmp" | tail -1)
      profile=$(sed -n 's/^PROFILE=//p' "$tmp" | tail -1)
      rm -f "$tmp"

      # Only a real rewrite owes a restart. `status`, `--dry-run` and `--json`
      # emit no CHANGED line, so asking what the bot runs never bounces it.
      [ "$changed" = "1" ] || return 0

      # Hermes caches the agent at startup: the new model is inert until the
      # gateway is bounced, and a bot still answering on the old model is worse
      # than one that was never switched.
      #
      # A single-config install has no per-profile unit: its bot is started by
      # whatever runs it, so the unit to bounce is the generic one if there is
      # one, and otherwise the user has to restart the bot themselves.
      local unit
      if [ -n "$profile" ]; then
        unit="hermes-gateway-${profile}.service"
      else
        unit="hermes-gateway.service"
      fi
      if ! systemctl --user restart "$unit" 2>/dev/null; then
        if [ -z "$profile" ] && systemctl --user list-unit-files 'hermes-gateway*.service' 2>/dev/null | command grep -q gateway; then
          unit=$(systemctl --user list-unit-files 'hermes-gateway*.service' 2>/dev/null | command grep gateway | head -1 | cut -d' ' -f1)
          systemctl --user restart "$unit" 2>/dev/null || true
        fi
        if ! systemctl --user is-active --quiet "$unit" 2>/dev/null; then
          echo -e "\033[33m! no hermes gateway unit to bounce — the new model is inert until the bot restarts.\033[0m" >&2
          return 0
        fi
      fi
      sleep 2
      if systemctl --user is-active --quiet "$unit"; then
        echo -e "\033[32m✔ $unit restarted\033[0m"
      else
        echo -e "\033[31m✗ $unit is not active — journalctl --user -u $unit -n 50\033[0m" >&2
        return 1
      fi
      ;;
    auth)
      # Forward every argument: `ccp auth trae --status` must reach the
      # helper, not be trimmed to the provider name.
      auth_provider "${@:2}"
      ;;
    accounts|account)
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_accounts.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/ccp_accounts.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)
      "$py_bin" "$repo_dir/bridge/ccp_accounts.py" "${@:2}"
      ;;
    doctor|--doctor)
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_doctor.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/ccp_doctor.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)
      "$py_bin" "$repo_dir/bridge/ccp_doctor.py" "${@:2}"
      ;;
    usage|--usage)
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_usage.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/ccp_usage.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)
      "$py_bin" "$repo_dir/bridge/ccp_usage.py" "${@:2}"
      ;;
    quota|--quota)
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_quota.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/ccp_quota.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)
      "$py_bin" "$repo_dir/bridge/ccp_quota.py" "${@:2}"
      ;;
    ping|probe|speed)
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_probe.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/ccp_probe.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)

      # `ccp ping deepseek v4.1flash` is one model name in two words — the point
      # of the command is "which vendor is fastest for this model", so the words
      # have to reach the matcher as one target. Flags (anything starting with
      # `-`) are passed through untouched for argparse.
      # Separate the model name from the flags. An option that takes a value
      # (`--timeout 60`) must carry it across, or `60` lands in the model name
      # and argparse reports the option as missing its argument.
      local -a target=() opts=()
      local a expect_value=0
      for a in "${@:2}"; do
        if [ "$expect_value" -eq 1 ]; then
          opts+=("$a"); expect_value=0; continue
        fi
        case "$a" in
          -*) opts+=("$a")
              case "$a" in
                --timeout|--tokens|--rounds|--sort|--concurrency|--base-url|--budget-tokens|-n)
                  expect_value=1 ;;
              esac ;;
          *) target+=("$a") ;;
        esac
      done

      local is_json=false
      local do_switch=false
      for arg in "$@"; do
        if [ "$arg" = "--json" ]; then
          is_json=true
        elif [ "$arg" = "--switch" ] || [ "$arg" = "-s" ]; then
          do_switch=true
        fi
      done

      if [ "$is_json" = false ]; then
        ensure_bridge_running "http://127.0.0.1:4000" >&2
      fi

      if [ "$do_switch" = true ]; then
        local tmp
        tmp=$(mktemp)
        "$py_bin" "$repo_dir/bridge/ccp_probe.py" "${target[*]-}" "${opts[@]+"${opts[@]}"}" | tee "$tmp"
        local exit_code="${PIPESTATUS[0]}"
        local switch_target
        switch_target=$(grep -E '^SWITCH_TO=' "$tmp" | tail -1 | sed 's/^SWITCH_TO=//')
        rm -f "$tmp"
        if [ -n "$switch_target" ]; then
          case "$switch_target" in
            MODEL\ *)
              local m="${switch_target#MODEL }"
              echo -e "\n\033[32mSwitching active model to: $m\033[0m"
              set_active_model "$m"
              ;;
            *)
              echo -e "\n\033[32mSwitching provider to recommended winner: $switch_target\033[0m"
              switch_provider $switch_target
              ;;
          esac
        fi
        return "$exit_code"
      else
        "$py_bin" "$repo_dir/bridge/ccp_probe.py" "${target[*]-}" "${opts[@]+"${opts[@]}"}"
      fi
      ;;
    models|--models)
      show_models "${2:-}"
      ;;
    render|--render)
      render_registry "${@:2}"
      ;;
    discover|--discover)
      discover_models "${@:2}"
      ;;
    sync|--sync)
      sync_providers
      ;;
    *)
      switch_provider "$1" "${2:-}"
      ;;
  esac
}

# Tests source this file to exercise helpers directly; every normal invocation
# runs one command and exits.
if [ -z "${CCP_LIB_ONLY:-}" ]; then
  main "$@"
fi
