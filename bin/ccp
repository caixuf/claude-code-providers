#!/usr/bin/env bash
# ccp — Claude Code Provider Switcher
# Seamlessly switch models and providers for Claude Code CLI.

set -e

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
PROVIDERS_DIR="${PROVIDERS_DIR:-$CLAUDE_DIR/providers}"
SETTINGS_FILE="${SETTINGS_FILE:-$CLAUDE_DIR/settings.json}"

show_help() {
  cat <<'EOF'
ccp — Claude Code Provider & Model Switcher

Usage:
  ccp                        List all available providers (* marks active)
  ccp <provider> [model]     Switch provider (and optionally override model)
  ccp -m, --model <model>    Switch model within the current active provider
  ccp -c, --current          Show currently active provider, model, and endpoints
  ccp -r, --rollback [N]     Roll back to the Nth most recent backup (default: 1)
  ccp -t, --test [name]      Quick test: send a ping through Claude Code
  ccp sync                   Sync local profiles with repository templates
  ccp bridge [action]        Manage local bridge: status, restart, start, stop, logs
  ccp -h, --help             Show this help message

In-Session Model Hot-Switching:
  Inside a running Claude Code session, type /model to switch between Opus,
  Sonnet, and Haiku tiers mapped to your provider's top models!

Examples:
  ccp cmdc-deepseek          # Switch to CommandCode DeepSeek
  ccp cmdc-deepseek space-bunny # Switch to CommandCode and set model to space-bunny
  ccp -m cmdc-space-bunny    # Change active model to space-bunny under current provider
  ccp cline-deepseek         # Switch to ClinePass Token Plan

Directories:
  Profiles:  ~/.claude/providers/*.json
  Active:    ~/.claude/settings.json
EOF
}

get_current_url() {
  if [ -f "$SETTINGS_FILE" ]; then
    grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$SETTINGS_FILE" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1
  fi
}

get_current_model() {
  if [ -f "$SETTINGS_FILE" ]; then
    grep -oE '"ANTHROPIC_MODEL"[^,]*' "$SETTINGS_FILE" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1
  fi
}

get_active_profile_name() {
  local cur_url cur_model
  cur_url=$(get_current_url)
  cur_model=$(get_current_model)
  if [ -z "$cur_url" ] && [ -z "$cur_model" ]; then
    return
  fi

  for p in "$PROVIDERS_DIR"/*.json; do
    [ -r "$p" ] || continue
    local p_url p_model
    p_url=$(grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$p" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
    p_model=$(grep -oE '"ANTHROPIC_MODEL"[^,]*' "$p" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
    if [ "$p_url" = "$cur_url" ]; then
      if [ "$p_model" = "$cur_model" ]; then
        basename "$p" .json
        return
      fi
    fi
  done

  # Fallback match by URL only
  for p in "$PROVIDERS_DIR"/*.json; do
    [ -r "$p" ] || continue
    local p_url
    p_url=$(grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$p" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
    if [ -n "$p_url" ] && [ "$p_url" = "$cur_url" ]; then
      basename "$p" .json
      return
    fi
  done
}

list_providers() {
  if [ ! -d "$PROVIDERS_DIR" ]; then
    echo "No providers directory found at $PROVIDERS_DIR"
    return 1
  fi

  local active cur_model
  active=$(get_active_profile_name)
  cur_model=$(get_current_model)

  local found=0
  for p in "$PROVIDERS_DIR"/*.json; do
    [ -r "$p" ] || continue
    found=1
    local name
    name=$(basename "$p" .json)
    if [ "$name" = "$active" ]; then
      printf " \033[32m* %-22s (active: %s)\033[0m\n" "$name" "${cur_model:-default}"
    else
      printf "   %-22s\n" "$name"
    fi
  done

  if [ "$found" -eq 0 ]; then
    echo "No provider profiles found in $PROVIDERS_DIR."
    echo "Add JSON profile files to $PROVIDERS_DIR/ to get started."
  fi
}

show_current() {
  local active url model
  active=$(get_active_profile_name)
  url=$(get_current_url)
  model=$(get_current_model)

  echo "Current Claude Code Settings:"
  if [ -n "$active" ]; then
    echo "  Profile:  $active"
  else
    echo "  Profile:  (custom / unmapped)"
  fi
  echo "  Base URL: ${url:-default (Anthropic official)}"
  echo "  Model:    ${model:-default}"
}

rollback_backup() {
  local n="${1:-1}"
  local bak
  bak=$(ls -1t "$SETTINGS_FILE".bak.* 2>/dev/null | sed -n "${n}p")
  if [ -n "$bak" ]; then
    cp "$bak" "$SETTINGS_FILE"
    echo "Rolled back settings.json to backup: $bak"
  else
    echo "No backups available to roll back."
  fi
}

set_active_model() {
  local model="$1"
  if [ -z "$model" ]; then
    echo "Error: model name required. Usage: ccp -m <model_name>" >&2
    return 1
  fi

  if [ ! -f "$SETTINGS_FILE" ]; then
    echo "Error: settings file $SETTINGS_FILE not found. Switch to a provider first." >&2
    return 1
  fi

  if command -v jq >/dev/null 2>&1; then
    local tmp
    tmp=$(mktemp)
    jq --arg m "$model" '
      .model = $m |
      .env.ANTHROPIC_MODEL = $m
    ' "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"
  else
    sed -i -E "s/\"ANTHROPIC_MODEL\": \"[^\"]+\"/\"ANTHROPIC_MODEL\": \"$model\"/" "$SETTINGS_FILE"
    sed -i -E "s/\"model\": \"[^\"]+\"/\"model\": \"$model\"/" "$SETTINGS_FILE"
  fi

  echo -e "\033[32m✔ Active model updated to: $model\033[0m"
  echo "Restart any active 'claude' interactive sessions to take effect."
}

check_bridge_port() {
  local port="$1"
  timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/$port" 2>/dev/null
}

ensure_bridge_running() {
  local url="$1"
  if [[ "$url" =~ (127\.0\.0\.1|localhost):4000 ]]; then
    local p4000=0 p4001=0
    check_bridge_port 4000 && p4000=1
    check_bridge_port 4001 && p4001=1

    if [ "$p4000" -eq 0 ] || [ "$p4001" -eq 0 ]; then
      echo -e "  \033[33m⚡ Universal Bridge (:4000 -> :4001) not running. Auto-starting...\033[0m"
      systemctl --user start litellm-cmdc.service ccp-sse-watchdog.service 2>/dev/null || true
      for _ in {1..10}; do
        sleep 0.5
        check_bridge_port 4000 && p4000=1
        check_bridge_port 4001 && p4001=1
        [ "$p4000" -eq 1 ] && [ "$p4001" -eq 1 ] && break
      done
      if [ "$p4000" -eq 1 ] && [ "$p4001" -eq 1 ]; then
        echo -e "  \033[32m✔ Universal Bridge active (SSE Watchdog :4000 -> LiteLLM :4001)\033[0m"
      else
        echo -e "  \033[31m⚠ Notice: Bridge services could not be reached. Run 'ccp bridge restart'\033[0m"
      fi
    else
      echo -e "  \033[32m✔ Universal Bridge healthy (SSE Watchdog :4000 -> LiteLLM :4001)\033[0m"
    fi
  fi
}

manage_bridge() {
  local action="${1:-status}"
  case "$action" in
    status)
      echo "Universal Bridge Status:"
      local p4000=0 p4001=0
      check_bridge_port 4000 && p4000=1
      check_bridge_port 4001 && p4001=1

      if [ "$p4000" -eq 1 ]; then
        echo -e "  Watchdog (:4000):   \033[32mRUNNING\033[0m"
      else
        echo -e "  Watchdog (:4000):   \033[31mSTOPPED\033[0m"
      fi

      if [ "$p4001" -eq 1 ]; then
        echo -e "  LiteLLM  (:4001):   \033[32mRUNNING\033[0m"
      else
        echo -e "  LiteLLM  (:4001):   \033[31mSTOPPED\033[0m"
      fi
      ;;
    restart)
      echo "Restarting bridge services..."
      systemctl --user restart litellm-cmdc.service 2>/dev/null || true
      sleep 1
      systemctl --user restart ccp-sse-watchdog.service 2>/dev/null || true
      manage_bridge status
      ;;
    start)
      echo "Starting bridge services..."
      systemctl --user start litellm-cmdc.service ccp-sse-watchdog.service 2>/dev/null || true
      sleep 1
      manage_bridge status
      ;;
    stop)
      echo "Stopping bridge services..."
      systemctl --user stop ccp-sse-watchdog.service litellm-cmdc.service 2>/dev/null || true
      manage_bridge status
      ;;
    logs)
      journalctl --user -u ccp-sse-watchdog.service -u litellm-cmdc.service -f -n 50
      ;;
    *)
      echo "Usage: ccp bridge [status|restart|start|stop|logs]"
      ;;
  esac
}

sync_providers() {
  local repo_dir="${CCP_REPO_DIR:-}"
  if [ -z "$repo_dir" ]; then
    local candidate
    for candidate in \
      "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)" \
      "$HOME/code/claude-code-providers" \
      "$HOME/.claude-code-providers" \
      "$HOME/claude-code-providers"; do
      if [ -d "$candidate/providers" ]; then
        repo_dir="$candidate"
        break
      fi
    done
  fi

  if [ -z "$repo_dir" ] || [ ! -d "$repo_dir/providers" ]; then
    echo -e "\033[31mError: repo providers directory not found.\033[0m" >&2
    echo "Set CCP_REPO_DIR or clone repo to ~/code/claude-code-providers or ~/.claude-code-providers" >&2
    return 1
  fi

  echo "Synchronizing profiles with repository templates ($repo_dir)..."
  mkdir -p "$PROVIDERS_DIR"
  mkdir -p "$CLAUDE_DIR/providers_disabled"

  for obsolete in cmdc-space-bunny.json longcat.json u2flash.json; do
    if [ -f "$PROVIDERS_DIR/$obsolete" ]; then
      mv "$PROVIDERS_DIR/$obsolete" "$CLAUDE_DIR/providers_disabled/"
      echo -e "  \033[33m-- Archived obsolete profile $obsolete to ~/.claude/providers_disabled/\033[0m"
    fi
  done

  local added=0
  for ex in "$repo_dir/providers"/*.json.example; do
    [ -f "$ex" ] || continue
    local base="$(basename "$ex" .example)"
    if [ ! -f "$PROVIDERS_DIR/$base" ]; then
      cp "$ex" "$PROVIDERS_DIR/$base"
      echo -e "  \033[32m✔ Added new provider template: $base\033[0m"
      added=$((added + 1))
    fi
  done

  echo -e "\033[32m✔ Sync complete. Active providers in $PROVIDERS_DIR:\033[0m"
  list_providers
}

test_provider() {
  local name="${1:-}"
  if [ -n "$name" ]; then
    switch_provider "$name"
  fi
  local cur_url
  cur_url=$(get_current_url)
  if [[ "$cur_url" =~ (127\.0\.0\.1|localhost):4000 ]]; then
    ensure_bridge_running "$cur_url"
  fi
  echo "Testing provider with 'claude -p \"say pong\"'..."
  claude -p "say pong"
}

switch_provider() {
  local name="$1"
  local model_override="${2:-}"
  local src="$PROVIDERS_DIR/$name.json"

  if [ ! -r "$src" ]; then
    # Try fuzzy match if user typed 'cmdc' instead of 'cmdc-deepseek'
    local match
    match=$(ls "$PROVIDERS_DIR"/$name*.json 2>/dev/null | head -1 || true)
    if [ -n "$match" ] && [ -r "$match" ]; then
      src="$match"
      name=$(basename "$match" .json)
    else
      echo -e "\033[31mError: unknown provider '$name'\033[0m" >&2
      echo "Available providers:" >&2
      list_providers >&2
      return 1
    fi
  fi

  mkdir -p "$CLAUDE_DIR"
  if [ -f "$SETTINGS_FILE" ]; then
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.bak.$(date +%Y%m%d-%H%M%S)"
  fi

  cp "$src" "$SETTINGS_FILE"

  local target_url
  target_url=$(grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$src" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)

  if [ -n "$model_override" ]; then
    set_active_model "$model_override"
  else
    echo -e "\033[32m✔ Switched to provider: $name\033[0m"
    if [ -n "$target_url" ]; then
      ensure_bridge_running "$target_url"
    fi
    echo "Restart any active 'claude' interactive sessions to take effect."
  fi
}

main() {
  case "${1:-}" in
    "")
      list_providers
      ;;
    -h|--help|help)
      show_help
      ;;
    -c|--current|current)
      show_current
      ;;
    -r|--rollback|rollback)
      rollback_backup "${2:-1}"
      ;;
    -m|--model|model)
      set_active_model "${2:-}"
      ;;
    -t|--test|test)
      test_provider "${2:-}"
      ;;
    bridge)
      manage_bridge "${2:-status}"
      ;;
    sync|--sync)
      sync_providers
      ;;
    *)
      switch_provider "$1" "${2:-}"
      ;;
  esac
}

main "$@"
