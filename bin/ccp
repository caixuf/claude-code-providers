#!/usr/bin/env bash
# ccp — Claude Code Provider Switcher
set -euo pipefail

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
PROVIDERS_DIR="${PROVIDERS_DIR:-$CLAUDE_DIR/providers}"
SETTINGS_FILE="${SETTINGS_FILE:-$CLAUDE_DIR/settings.json}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd -P)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
GATEWAY_PY="$ROOT_DIR/bridge/gateway.py"
GATEWAY_URL="${CCP_GATEWAY_URL:-http://127.0.0.1:4000}"

show_help() {
  cat <<'EOF'
ccp — Claude Code Provider Switcher

Usage:
  ccp                      List providers (* = active)
  ccp <name>               Switch provider (backs up ~/.claude/settings.json)
  ccp use <name>           Same as ccp <name>
  ccp -c, --current        Active profile + endpoint
  ccp -r, --rollback [N]   Restore Nth newest settings backup (default 1)
  ccp -t, --test [name]    claude -p "say pong"
  ccp gateway start|stop|status
  ccp -h, --help

Aliases: cmdc → cmdc-deepseek, cline → cline-deepseek, minmax|mm → minimax, ds → deepseek, step → stepfun

Profiles: ~/.claude/providers/*.json
Active:   ~/.claude/settings.json
Bridge:   127.0.0.1:4000  (cmdc / cline OpenAI upstreams)
EOF
}

normalize_name() {
  case "${1:-}" in
    cmdc|cmdc-deepseek) echo cmdc-deepseek ;;
    cline|cline-deepseek) echo cline-deepseek ;;
    minmax|mm|minimax) echo minimax ;;
    ds|deepseek) echo deepseek ;;
    step|stepfun) echo stepfun ;;
    *) echo "${1:-}" ;;
  esac
}

get_current_url() {
  python3 - "$SETTINGS_FILE" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1])
if not p.is_file():
    print(""); raise SystemExit
s=json.loads(p.read_text())
print((s.get("env") or {}).get("ANTHROPIC_BASE_URL",""))
PY
}

get_current_model() {
  python3 - "$SETTINGS_FILE" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1])
if not p.is_file():
    print(""); raise SystemExit
s=json.loads(p.read_text())
print(s.get("model") or (s.get("env") or {}).get("ANTHROPIC_MODEL",""))
PY
}

get_active_profile_name() {
  python3 - "$SETTINGS_FILE" "$PROVIDERS_DIR" <<'PY'
import json,sys
from pathlib import Path
settings_path, prov_dir = Path(sys.argv[1]), Path(sys.argv[2])
if not settings_path.is_file() or not prov_dir.is_dir():
    raise SystemExit
s=json.loads(settings_path.read_text())
env=s.get("env") or {}
url, model = env.get("ANTHROPIC_BASE_URL",""), s.get("model") or env.get("ANTHROPIC_MODEL","")
for p in sorted(prov_dir.glob("*.json")):
    try:
        d=json.loads(p.read_text())
    except Exception:
        continue
    e=d.get("env") or {}
    if e.get("ANTHROPIC_BASE_URL","")==url and (d.get("model") or e.get("ANTHROPIC_MODEL",""))==model:
        print(p.stem)
        break
PY
}

gateway_alive() {
  python3 -c "from urllib.request import urlopen; urlopen('${GATEWAY_URL}/health', timeout=1.2).read()" 2>/dev/null
}

cmd_gateway() {
  local action="${1:-status}"
  case "$action" in
    start)
      if gateway_alive; then
        echo "ccp gateway: already up ${GATEWAY_URL}"
        return 0
      fi
      if command -v systemctl >/dev/null 2>&1 && systemctl --user start ccp-gateway.service 2>/dev/null; then
        sleep 0.8
        if gateway_alive; then
          echo "ccp gateway: systemd --user ccp-gateway.service"
          return 0
        fi
      fi
      nohup python3 "$GATEWAY_PY" >/tmp/ccp-gateway.log 2>&1 &
      sleep 0.8
      if gateway_alive; then
        echo "ccp gateway: nohup ${GATEWAY_URL}"
      else
        echo "ccp gateway: start failed (see /tmp/ccp-gateway.log)" >&2
        return 1
      fi
      ;;
    stop)
      systemctl --user stop ccp-gateway.service 2>/dev/null || true
      pkill -f "$GATEWAY_PY" 2>/dev/null || true
      echo "ccp gateway: stopped"
      ;;
    status|st)
      if gateway_alive; then
        echo "ccp gateway: up ${GATEWAY_URL}"
      else
        echo "ccp gateway: down ${GATEWAY_URL}"
        return 1
      fi
      ;;
    *)
      echo "ccp gateway: start | stop | status" >&2
      return 2
      ;;
  esac
}

list_providers() {
  if [ ! -d "$PROVIDERS_DIR" ]; then
    echo "No providers directory found at $PROVIDERS_DIR"
    return 1
  fi
  local active
  active=$(get_active_profile_name || true)
  local found=0
  local p name
  for p in "$PROVIDERS_DIR"/*.json; do
    [ -r "$p" ] || continue
    found=1
    name=$(basename "$p" .json)
    if [ "$name" = "$active" ]; then
      printf " \033[32m* %-22s (active)\033[0m\n" "$name"
    else
      printf "   %-22s\n" "$name"
    fi
  done
  if [ "$found" -eq 0 ]; then
    echo "No provider profiles in $PROVIDERS_DIR."
  fi
}

show_current() {
  echo "Current Claude Code Settings:"
  echo "  Profile:  $(get_active_profile_name || echo '(custom / unmapped)')"
  echo "  Base URL: $(get_current_url || echo default)"
  echo "  Model:    $(get_current_model || echo default)"
  if gateway_alive; then
    echo "  Gateway:  up ${GATEWAY_URL}"
  else
    echo "  Gateway:  down ${GATEWAY_URL}"
  fi
}

rollback_backup() {
  local n="${1:-1}"
  local bak
  bak=$(ls -1t "$SETTINGS_FILE".bak.* 2>/dev/null | sed -n "${n}p" || true)
  if [ -n "$bak" ]; then
    cp "$bak" "$SETTINGS_FILE"
    echo "Rolled back settings.json to backup: $bak"
  else
    echo "No backups available to roll back."
  fi
}

test_provider() {
  local name="${1:-}"
  if [ -n "$name" ]; then
    switch_provider "$name"
  fi
  echo "Testing provider with 'claude -p \"say pong\"'..."
  claude -p "say pong"
}

switch_provider() {
  local name
  name=$(normalize_name "$1")
  local src="$PROVIDERS_DIR/$name.json"

  if [ ! -r "$src" ]; then
    echo -e "\033[31mError: unknown provider '$name'\033[0m" >&2
    echo "Available providers:" >&2
    list_providers >&2
    return 1
  fi

  mkdir -p "$CLAUDE_DIR"
  if [ -f "$SETTINGS_FILE" ]; then
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.bak.$(date +%Y%m%d-%H%M%S)"
  fi
  cp "$src" "$SETTINGS_FILE"

  if grep -q '127.0.0.1:4000' "$src" 2>/dev/null; then
    cmd_gateway start || true
  fi

  echo -e "\033[32m✔ Switched to provider: $name\033[0m"
  echo "Restart any active 'claude' sessions to take effect."
}

main() {
  case "${1:-}" in
    "")
      list_providers
      ;;
    -h|--help|help)
      show_help
      ;;
    -c|--current|current|status)
      show_current
      ;;
    -r|--rollback|rollback)
      rollback_backup "${2:-1}"
      ;;
    -t|--test|test)
      test_provider "${2:-}"
      ;;
    use)
      shift
      if [ -z "${1:-}" ]; then
        echo "ccp use: need a provider name" >&2
        return 1
      fi
      switch_provider "$1"
      ;;
    gateway)
      shift
      cmd_gateway "${1:-status}"
      ;;
    *)
      switch_provider "$1"
      ;;
  esac
}

main "$@"
