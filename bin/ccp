#!/usr/bin/env bash
# ccp — Claude Code Provider Switcher
# Seamlessly switch models and providers for Claude Code CLI.

set -e

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
PROVIDERS_DIR="${PROVIDERS_DIR:-$CLAUDE_DIR/providers}"
SETTINGS_FILE="${SETTINGS_FILE:-$CLAUDE_DIR/settings.json}"

# Resolve the repo checkout that holds registry/ and bridge/.
ccp_repo_dir() {
  if [ -n "${CCP_REPO_DIR:-}" ] && [ -d "$CCP_REPO_DIR/bridge" ]; then
    echo "$CCP_REPO_DIR"; return
  fi
  # Resolve symlinks before deriving the path. An installed `ccp` is normally a
  # symlink at ~/.local/bin/ccp, and BASH_SOURCE would otherwise point there,
  # whose parent has no bridge/ — the install would silently fall through to a
  # guessed checkout and edit the wrong tree (or nothing at all).
  local self="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1; then
    local resolved
    resolved=$(readlink -f "$self" 2>/dev/null || true)
    [ -n "$resolved" ] && self="$resolved"
  fi

  local c
  for c in \
    "$(cd "$(dirname "$self")/.." 2>/dev/null && pwd)" \
    "$HOME/code/claude-code-providers" \
    "$HOME/.claude-code-providers" \
    "$HOME/claude-code-providers"; do
    if [ -d "$c/bridge" ]; then echo "$c"; return; fi
  done
}

# Prefer the litellm venv python (has pyyaml + litellm); fall back to python3.
ccp_python() {
  if [ -x "$HOME/.local/share/litellm-venv/bin/python3" ]; then
    echo "$HOME/.local/share/litellm-venv/bin/python3"
  else
    command -v python3
  fi
}

show_help() {
  cat <<'EOF'
ccp — Claude Code Provider & Model Switcher

Usage:
  ccp                        List all available providers (* marks active)
  ccp <provider> [model]     Switch provider (and optionally override model)
  ccp -m, --model <model>    Switch model within the current active provider
  ccp -c, --current          Show currently active provider, model, and endpoints
  ccp -r, --rollback [N]     Roll back to the Nth most recent backup (default: 1)
  ccp -t, --test [name]      Quick test: send a ping through Claude Code
  ccp ping [provider|model]  Probe model health, TTFT & token speed (options:
                             -q/--quick, -b/--bench, -n/--rounds, --sort, -s/--switch)
  ccp models [provider]      List models with context / output cap / vision
  ccp render                 Regenerate config + profiles from the registry
  ccp discover [provider]    Refresh model metadata from provider APIs
  ccp sync                   Sync local profiles with repository templates
  ccp bridge [action]        Manage local bridge: status, restart, start, stop,
                             deploy, logs, start-trae/stop-trae/restart-trae (the Trae adapter)
  ccp auth [copilot|codebuddy|trae]
                             Authenticate a provider (Copilot device flow,
                             import the CodeBuddy login, or the TraeCLI token)
  ccp accounts [action]      Several logins for one provider, and routing groups:
                             list | add <provider> <suffix> | remove <provider> <suffix>
                             | group add <name> <member...> | group remove <name>
                             (a pool fails over natively when a quota runs out)
  ccp quota [provider]       What is left on each plan (CodeBuddy credits, …)
  ccp -h, --help             Show this help message

In-Session Model Hot-Switching:
  Inside a running Claude Code session, type /model to switch between Opus,
  Sonnet, and Haiku tiers mapped to your provider's top models!

Examples:
  ccp cmdc-deepseek          # Switch to CommandCode DeepSeek
  ccp cmdc-deepseek space-bunny # Switch to CommandCode and set model to space-bunny
  ccp -m cmdc-space-bunny    # Change active model to space-bunny under current provider
  ccp ping                   # 2-round sustained speed & stability test (~60 tokens)
  ccp ping -b                # Deep benchmark (3 rounds, ~100 tokens, strict stress test)
  ccp ping -q                # Quick check (1 round, 20 tokens, fast health ping)
  ccp ping trae -s           # Benchmark Trae models and auto-switch to the winner
  ccp cline-deepseek         # Switch to ClinePass Token Plan
  ccp auth copilot           # Authorize GitHub Copilot via device flow
  ccp copilot                # Switch to GitHub Copilot (Claude Sonnet 5.5, Haiku 5.5, Opus 5.5)
  ccp auth codebuddy         # Import the CodeBuddy Code login token into the bridge
  ccp codebuddy              # Switch to CodeBuddy (DeepSeek v4.1 Flash / GLM-5.3 / GLM-5.3-Flash)
  ccp accounts add codebuddy a2   # Name a second login, then `ccp render`
  ccp accounts group add daily codebuddy cmdc-deepseek-fast
  ccp -m group/daily         # One name over several models; fails over when one runs out

Directories:
  Profiles:  ~/.claude/providers/*.json
  Active:    ~/.claude/settings.json
EOF
}

get_current_url() {
  if [ -f "$SETTINGS_FILE" ]; then
    grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$SETTINGS_FILE" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1
  fi
}

get_current_model() {
  if [ -f "$SETTINGS_FILE" ]; then
    grep -oE '"ANTHROPIC_MODEL"[^,]*' "$SETTINGS_FILE" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1
  fi
}

get_active_profile_name() {
  local cur_url cur_model
  cur_url=$(get_current_url)
  cur_model=$(get_current_model)
  if [ -z "$cur_url" ] && [ -z "$cur_model" ]; then
    return
  fi

  for p in "$PROVIDERS_DIR"/*.json; do
    [ -r "$p" ] || continue
    local p_url p_model
    p_url=$(grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$p" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
    p_model=$(grep -oE '"ANTHROPIC_MODEL"[^,]*' "$p" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
    if [ "$p_url" = "$cur_url" ]; then
      if [ "$p_model" = "$cur_model" ]; then
        basename "$p" .json
        return
      fi
    fi
  done

  # Fallback match by URL only
  for p in "$PROVIDERS_DIR"/*.json; do
    [ -r "$p" ] || continue
    local p_url
    p_url=$(grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$p" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
    if [ -n "$p_url" ] && [ "$p_url" = "$cur_url" ]; then
      basename "$p" .json
      return
    fi
  done
}

list_providers() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_pick.py" ]; then
    echo -e "\033[31mError: repo checkout not found (need bridge/ccp_pick.py).\033[0m" >&2
    return 1
  fi

  local active cur_model
  active=$(get_active_profile_name)
  cur_model=$(get_current_model)

  local folders
  folders=$("$(ccp_python)" "$repo_dir/bridge/ccp_pick.py" folders) || return 1
  [ -n "$folders" ] || { echo "No provider profiles found."; return 1; }

  local name kind count default ctx
  while IFS='|' read -r name kind count default ctx; do
    [ -n "$name" ] || continue
    if [ "$name" = "$active" ]; then
      printf " \033[32m* %-14s\033[0m %-8s %2s models   active: %s\n" \
        "$name/" "$kind" "$count" "${cur_model:-$default}"
    else
      printf "   %-14s %-8s %2s models   %s\n" "$name/" "$kind" "$count" "$default"
    fi
  done <<< "$folders"

  cat <<'EOF'

Each provider is a folder; its models are the contents.

  ccp <provider>              switch to that provider's default model
  ccp <provider> <model>      switch to a specific model  (also: ccp <p>/<model>)
  ccp models <provider>       just list a provider's models, change nothing
EOF
}

list_provider_models() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_pick.py" ]; then
    echo -e "\033[31mError: repo checkout not found (need bridge/ccp_pick.py).\033[0m" >&2
    return 1
  fi
  "$(ccp_python)" "$repo_dir/bridge/ccp_pick.py" list "$1"
}

show_current() {
  local active url model
  active=$(get_active_profile_name)
  url=$(get_current_url)
  model=$(get_current_model)

  echo "Current Claude Code Settings:"
  if [ -n "$active" ]; then
    echo "  Profile:  $active"
  else
    echo "  Profile:  (custom / unmapped)"
  fi
  echo "  Base URL: ${url:-default (Anthropic official)}"
  echo "  Model:    ${model:-default}"
}

rollback_backup() {
  local n="${1:-1}"
  local bak
  bak=$(ls -1t "$SETTINGS_FILE".bak.* 2>/dev/null | sed -n "${n}p")
  if [ -n "$bak" ]; then
    cp "$bak" "$SETTINGS_FILE"
    echo "Rolled back settings.json to backup: $bak"
  else
    echo "No backups available to roll back."
  fi
}

set_active_model() {
  local model="$1"
  if [ -z "$model" ]; then
    echo "Error: model name required. Usage: ccp -m <model_name>" >&2
    return 1
  fi

  # `ccp -m group/daily` is the documented spelling of a routing group, but
  # LiteLLM reads a `/` in a model name as a provider prefix: it answers
  # `Invalid model name passed in model=group/daily` and the session dies with
  # a 400. render_config.py registers the group under its bare name, so drop
  # the prefix here and let both spellings work.
  case "$model" in
    group/*) model="${model#group/}" ;;
  esac

  if [ ! -f "$SETTINGS_FILE" ]; then
    echo "Error: settings file $SETTINGS_FILE not found. Switch to a provider first." >&2
    return 1
  fi

  # ctx is passed when the caller knows the model's real context window:
  # CLAUDE_CODE_MAX_CONTEXT_TOKENS is per-profile, so switching to a smaller
  # model must not leave the old number advertised or Claude Code will ask for
  # a window the model cannot honour.
  local ctx="${2:-}"

  if command -v jq >/dev/null 2>&1; then
    local tmp
    tmp=$(mktemp)
    if [ -n "$ctx" ]; then
      jq --arg m "$model" --argjson c "$ctx" '
        .model = $m |
        .env.ANTHROPIC_MODEL = $m |
        .env.CLAUDE_CODE_MAX_CONTEXT_TOKENS = ($c | tostring)
      ' "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"
    else
      jq --arg m "$model" '
        .model = $m |
        .env.ANTHROPIC_MODEL = $m
      ' "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"
    fi
  else
    sed -i -E "s/\"ANTHROPIC_MODEL\": \"[^\"]+\"/\"ANTHROPIC_MODEL\": \"$model\"/" "$SETTINGS_FILE"
    sed -i -E "s/\"model\": \"[^\"]+\"/\"model\": \"$model\"/" "$SETTINGS_FILE"
    if [ -n "$ctx" ]; then
      sed -i -E "s/\"CLAUDE_CODE_MAX_CONTEXT_TOKENS\": \"[^\"]+\"/\"CLAUDE_CODE_MAX_CONTEXT_TOKENS\": \"$ctx\"/" "$SETTINGS_FILE"
    fi
  fi

  echo -e "\033[32m✔ Active model updated to: $model\033[0m"
  echo "Restart any active 'claude' interactive sessions to take effect."
}

check_bridge_port() {
  local port="$1"
  timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/$port" 2>/dev/null
}

sync_proxy_env() {
  local cfg_dir="$HOME/.config/litellm"
  local env_file="$cfg_dir/proxy.env"
  local proxy_url="${https_proxy:-${http_proxy:-${HTTPS_PROXY:-${HTTP_PROXY:-}}}}"

  if [ -z "$proxy_url" ]; then
    for p in 7897 7899 7892; do
      if timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/$p" 2>/dev/null; then
        proxy_url="http://127.0.0.1:$p"
        break
      fi
    done
  fi

  # render_config.py emits `api_key: os.environ/<PROVIDER>_API_KEY`, so the
  # credential lines in proxy.env are load-bearing. Only (re)write the proxy
  # vars here and carry every other line over verbatim — a plain `cat >` used
  # to truncate the file and silently wipe every *_API_KEY on each run.
  local keep=""
  if [ -f "$env_file" ]; then
    keep=$(grep -viE '^[[:space:]]*(https?_proxy|no_proxy)[[:space:]]*=' "$env_file" || true)
  fi

  if [ -n "$proxy_url" ] || [ -n "$keep" ]; then
    mkdir -p "$cfg_dir"
    local tmp
    tmp=$(mktemp)
    if [ -n "$proxy_url" ]; then
      cat >> "$tmp" <<EOF
http_proxy=$proxy_url
https_proxy=$proxy_url
HTTP_PROXY=$proxy_url
HTTPS_PROXY=$proxy_url
no_proxy=localhost,127.0.0.1,::1,.local
NO_PROXY=localhost,127.0.0.1,::1,.local
EOF
    fi
    [ -n "$keep" ] && printf '%s\n' "$keep" >> "$tmp"
    mv "$tmp" "$env_file"
  fi
}

ensure_bridge_running() {
  local url="$1"
  if [[ "$url" =~ (127\.0\.0\.1|localhost):4000 ]]; then
    sync_proxy_env
    local p4000=0 p4001=0
    check_bridge_port 4000 && p4000=1
    check_bridge_port 4001 && p4001=1

    if [ "$p4000" -eq 0 ] || [ "$p4001" -eq 0 ]; then
      echo -e "  \033[33m⚡ Universal Bridge (:4000 -> :4001) not running. Auto-starting...\033[0m"
      systemctl --user start litellm-cmdc.service ccp-sse-watchdog.service 2>/dev/null || true
      for _ in {1..10}; do
        sleep 0.5
        check_bridge_port 4000 && p4000=1
        check_bridge_port 4001 && p4001=1
        [ "$p4000" -eq 1 ] && [ "$p4001" -eq 1 ] && break
      done
      if [ "$p4000" -eq 1 ] && [ "$p4001" -eq 1 ]; then
        echo -e "  \033[32m✔ Universal Bridge active (SSE Watchdog :4000 -> LiteLLM :4001)\033[0m"
      else
        echo -e "  \033[31m⚠ Notice: Bridge services could not be reached. Run 'ccp bridge restart'\033[0m"
      fi
    else
      echo -e "  \033[32m✔ Universal Bridge healthy (SSE Watchdog :4000 -> LiteLLM :4001)\033[0m"
    fi
  fi

  # Trae is a separate, self-contained adapter on :4100 — it speaks Anthropic
  # itself, so it never touches LiteLLM or the watchdog. Same auto-start
  # contract as the universal bridge so `ccp trae` works from a cold shell.
  if [[ "$url" =~ (127\.0\.0\.1|localhost):4100 ]]; then
    sync_proxy_env
    if check_bridge_port 4100; then
      echo -e "  \033[32m✔ Trae bridge healthy (:4100)\033[0m"
      return 0
    fi
    echo -e "  \033[33m⚡ Trae bridge (:4100) not running. Auto-starting...\033[0m"
    if systemctl --user start ccp-trae-bridge.service 2>/dev/null; then
      for _ in {1..10}; do
        sleep 0.5
        check_bridge_port 4100 && break
      done
    fi
    if check_bridge_port 4100; then
      echo -e "  \033[32m✔ Trae bridge active (:4100)\033[0m"
    elif [ ! -f "$HOME/.config/systemd/user/ccp-trae-bridge.service" ]; then
      echo -e "  \033[33m⚠ No service installed. Run this once:\033[0m"
      echo -e "      cp \$(ccp_repo_dir)/bridge/ccp-trae-bridge.service.example \\"
      echo -e "         \$HOME/.config/systemd/user/ccp-trae-bridge.service"
      echo -e "      systemctl --user daemon-reload && systemctl --user enable --now ccp-trae-bridge.service"
    else
      echo -e "  \033[31m⚠ Trae bridge failed to start: systemctl --user status ccp-trae-bridge.service\033[0m"
    fi
  fi
}

# Adopt credentials the owning CLI may have rotated since the last import.
#
# ccp deliberately does not refresh provider logins itself: for CodeBuddy the
# CLI is the single holder of the rotating refresh token, and refreshing here
# would rotate it out from under the CLI. Instead the *source of truth* is
# re-read on every bridge start, so a session the CLI renewed is picked up
# rather than silently going stale in proxy.env. Silent when the provider is
# not in use at all.
sync_provider_credentials() {
  local repo_dir py
  repo_dir=$(ccp_repo_dir)
  [ -n "$repo_dir" ] && [ -f "$repo_dir/bridge/codebuddy_auth.py" ] || return 0
  py=$(ccp_python)
  "$py" "$repo_dir/bridge/codebuddy_auth.py" --if-stale 2>&1 | sed 's/^/  /' || true
}

# Copy the freshly rendered bridge config into service, because `ccp render`
# only writes bridge/config.generated.yaml. Without this step `ccp render` +
# `ccp bridge restart` silently kept serving the previous model list — a new
# provider (or a corrected clamp map) looked like it had no effect.
# setup_bridge.sh performs the same copy on install.
deploy_bridge_config() {
  local repo_dir src dst
  repo_dir=$(ccp_repo_dir)
  src="$repo_dir/bridge/config.generated.yaml"
  dst="$HOME/.config/litellm/config.yaml"
  [ -n "$repo_dir" ] && [ -f "$src" ] || return 0

  # The watchdog reads bridge/clamp_map.json and bridge/request_rules.json
  # straight out of the checkout, so only the LiteLLM config needs deploying.
  if [ -f "$dst" ] && cmp -s "$src" "$dst"; then
    return 0
  fi

  if [ -f "$dst" ]; then
    # A hand-edited config.yaml can hold literal api_key values, which
    # setup_bridge.sh migrates into proxy.env. Never drop those on the floor.
    if grep -E '^[[:space:]]*api_key:' "$dst" 2>/dev/null | grep -qv 'os.environ/'; then
      echo -e "  \033[33m⚠ $dst contains literal api_key values — not overwriting.\033[0m"
      echo "    Run 'bash bridge/setup_bridge.sh' to migrate them into proxy.env first."
      return 0
    fi
    cp "$dst" "$dst.bak.$(date +%Y%m%d-%H%M%S)"
  fi

  mkdir -p "$(dirname "$dst")"
  if cp "$src" "$dst"; then
    echo -e "  \033[32m✔ Deployed bridge config -> $dst\033[0m"
  else
    echo -e "  \033[31m! Failed to deploy bridge config to $dst\033[0m" >&2
    return 1
  fi
}

manage_bridge() {
  local action="${1:-status}"
  case "$action" in
    start-trae|stop-trae|restart-trae)
      # Addresses the Trae adapter only. It deliberately does NOT deploy
      # config.generated.yaml: the adapter needs no LiteLLM config, and pushing
      # one here would touch the running universal bridge for no benefit.
      systemctl --user "${action%-trae}" ccp-trae-bridge.service 2>/dev/null || {
        echo -e "\033[31mNo ccp-trae-bridge.service installed. See README → Trae CLI.\033[0m" >&2
        return 1
      }
      sleep 1
      if check_bridge_port 4100; then
        echo -e "\033[32m✔ Trae bridge active (:4100)\033[0m"
      else
        echo -e "\033[31m✗ Trae bridge down — systemctl --user status ccp-trae-bridge.service\033[0m"
      fi
      ;;
    status)
      echo "Universal Bridge Status:"
      local p4000=0 p4001=0
      check_bridge_port 4000 && p4000=1
      check_bridge_port 4001 && p4001=1

      if [ "$p4000" -eq 1 ]; then
        echo -e "  Watchdog (:4000):   \033[32mRUNNING\033[0m"
      else
        echo -e "  Watchdog (:4000):   \033[31mSTOPPED\033[0m"
      fi

      if [ "$p4001" -eq 1 ]; then
        echo -e "  LiteLLM  (:4001):   \033[32mRUNNING\033[0m"
      else
        echo -e "  LiteLLM  (:4001):   \033[31mSTOPPED\033[0m"
      fi

      # The Trae adapter is independent of the above two — it never goes
      # through LiteLLM — so report it separately rather than implying the
      # universal bridge covers it.
      if check_bridge_port 4100; then
        echo -e "  Trae     (:4100):   \033[32mRUNNING\033[0m"
      else
        echo -e "  Trae     (:4100):   \033[31mSTOPPED\033[0m  (ccp auth trae; ccp bridge start trae)"
      fi
      ;;
    restart)
      echo "Restarting bridge services..."
      sync_provider_credentials
      deploy_bridge_config
      sync_proxy_env
      systemctl --user restart litellm-cmdc.service 2>/dev/null || true
      sleep 1.5
      systemctl --user restart ccp-sse-watchdog.service 2>/dev/null || true
      sleep 0.5
      manage_bridge status
      ;;
    start)
      echo "Starting bridge services..."
      sync_provider_credentials
      deploy_bridge_config
      sync_proxy_env
      systemctl --user start litellm-cmdc.service ccp-sse-watchdog.service 2>/dev/null || true
      sleep 1
      manage_bridge status
      ;;
    deploy)
      deploy_bridge_config
      manage_bridge status
      ;;
    stop)
      echo "Stopping bridge services..."
      systemctl --user stop ccp-sse-watchdog.service litellm-cmdc.service 2>/dev/null || true
      manage_bridge status
      ;;
    logs)
      journalctl --user -u ccp-sse-watchdog.service -u litellm-cmdc.service -f -n 50
      ;;
    *)
      echo "Usage: ccp bridge [status|restart|start|stop|deploy|logs|start-trae|stop-trae|restart-trae]"
      ;;
  esac
}

auth_provider() {
  local target="${1:-copilot}"
  case "$target" in
    copilot|github-copilot|github)
      echo -e "\033[36m=== GitHub Copilot Authentication (Device Flow) ===\033[0m"
      local py_bin="$HOME/.local/share/litellm-venv/bin/python3"
      if [ ! -x "$py_bin" ]; then
        py_bin=$(command -v python3)
      fi
      if ! "$py_bin" -c "import litellm" 2>/dev/null; then
        echo -e "\033[31mError: litellm not found in $py_bin. Run bridge setup first: bash bridge/setup_bridge.sh\033[0m" >&2
        return 1
      fi

      export GITHUB_COPILOT_FORCE_LOGIN=1
      "$py_bin" -c '
import sys
from litellm.llms.github_copilot.authenticator import Authenticator

try:
    auth = Authenticator()
    token = auth.get_access_token()
    if token:
        print("\n\033[32m✔ Authentication successful! Copilot access token has been verified.\033[0m")
        print(f"Token file: {auth.access_token_file}")
        key = auth.get_api_key()
        if key:
            print(f"API key file: {auth.api_key_file}")
            print("\033[32m✔ Copilot session API key successfully refreshed!\033[0m")
except KeyboardInterrupt:
    print("\nAuthorization cancelled by user.")
    sys.exit(130)
except Exception as e:
    print(f"\n\033[31mAuthentication failed: {e}\033[0m", file=sys.stderr)
    sys.exit(1)
'
      local ret=$?
      if [ $ret -eq 0 ]; then
        echo ""
        echo -e "\033[32m✔ Copilot credentials ready!\033[0m"
        echo "Restart bridge:  ccp bridge restart"
        echo "Switch profile:  ccp copilot"
      fi
      return $ret
      ;;
    codebuddy|cb)
      local repo_dir py_bin explicit=0
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/codebuddy_auth.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/codebuddy_auth.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)
      # Explicit flags (--status, --no-verify, …) win; otherwise import and prove
      # the token really streams.
      if [ "$#" -gt 1 ]; then
        explicit=1
        "$py_bin" "$repo_dir/bridge/codebuddy_auth.py" "${@:2}"
      else
        echo -e "\033[36m=== CodeBuddy Authentication (import local CLI login) ===\033[0m"
        "$py_bin" "$repo_dir/bridge/codebuddy_auth.py" --verify
      fi
      local ret=$?
      if [ $ret -eq 0 ] && [ $explicit -eq 0 ]; then
        echo ""
        echo -e "\033[32m✔ CodeBuddy credentials ready!\033[0m"
        echo "Restart bridge:  ccp bridge restart"
        echo "Switch profile:  ccp codebuddy"
      fi
      return $ret
      ;;
    trae|traecli)
      # TraeCLI keeps its personal access token in ~/.bashrc rather than a
      # keychain. Copy it into the shared secrets file so the bridge works
      # without an interactive shell, then prove the subscription answers.
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/trae_auth.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/trae_auth.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)
      echo -e "\033[36m=== Trae Authentication (import TraeCLI token) ===\033[0m"
      "$py_bin" "$repo_dir/bridge/trae_auth.py" "${@:2}"
      return $?
      ;;
    *)
      echo "Usage: ccp auth [copilot|codebuddy|trae]" >&2
      return 1
      ;;
  esac
}

render_registry() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ]; then
    echo -e "\033[31mError: repo checkout not found (need registry/ and bridge/).\033[0m" >&2
    echo "Set CCP_REPO_DIR or clone to ~/code/claude-code-providers" >&2
    return 1
  fi
  local py
  py=$(ccp_python)
  "$py" "$repo_dir/bridge/render_config.py" "$@"
}

discover_models() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ]; then
    echo -e "\033[31mError: repo checkout not found.\033[0m" >&2
    return 1
  fi
  local py
  py=$(ccp_python)
  echo "Refreshing model metadata from provider APIs..."
  "$py" "$repo_dir/bridge/discover_models.py" "$@"
}

show_models() {
  local filter="${1:-}"
  local repo_dir
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/registry/models.yaml" ]; then
    echo -e "\033[31mError: registry/models.yaml not found. Run 'ccp discover' first.\033[0m" >&2
    return 1
  fi
  local py
  py=$(ccp_python)
  local active_model
  active_model=$(get_current_model)
  "$py" - "$repo_dir/registry/models.yaml" "$repo_dir/registry/profiles.yaml" "$filter" "$active_model" <<'PY'
import sys, yaml
models_path, profiles_path, filt, active = sys.argv[1:5]
doc = yaml.safe_load(open(models_path)) or {}
try:
    prof = yaml.safe_load(open(profiles_path)) or {}
except Exception:
    prof = {}
# alias index: (provider, model) -> alias
aliases = {}
for a, s in (prof.get("aliases") or {}).items():
    aliases[(s["provider"], s["model"])] = a
exposed = set(prof.get("expose_models") or [])
PROV_ORDER = [p["name"] for p in doc.get("providers", [])]
def fmt_ctx(c):
    if not c: return "?"
    return f"{c//1000}k" if c < 1_000_000 else f"{c/1_000_000:.0f}M".replace(".0M","M")
for p in doc.get("providers", []):
    if filt and filt != p["name"]:
        continue
    # show every model for small providers, or when the user asked for one
    show_all = bool(filt) or len(p["models"]) <= 12
    print(f"\n\033[36m{p['name']}\033[0m ({p.get('endpoint_kind')}, {len(p['models'])} models)  {p.get('api_base','')}")
    print(f"  {'alias / model':40s} {'ctx':>6}  {'out':>7}  vis")
    for m in p["models"]:
        a = aliases.get((p["name"], m["name"]))
        name = a if a else m["name"]
        star = "\033[32m*\033[0m" if active and (active == name or active.split('[')[0] == name) else " "
        # only show curated/exposed models in the compact summary view
        if not show_all and not a and m["name"] not in exposed:
            continue
        vis = "yes" if m.get("vision") is True else ("no" if m.get("vision") is False else "-")
        out = m.get("max_output")
        print(f"{star} {name:40s} {fmt_ctx(m.get('ctx')):>6}  {str(out or '?'):>7}  {vis}")
    if not show_all:
        shown = sum(1 for m in p["models"] if aliases.get((p["name"],m["name"])) or m["name"] in exposed)
        if shown < len(p["models"]):
            print(f"    … {len(p['models']) - shown} more — run 'ccp models {p['name']}' to list all")
PY
}

sync_providers() {
  local repo_dir
  repo_dir=$(ccp_repo_dir)

  if [ -z "$repo_dir" ] || [ ! -d "$repo_dir/providers" ]; then
    echo -e "\033[31mError: repo providers directory not found.\033[0m" >&2
    echo "Set CCP_REPO_DIR or clone repo to ~/code/claude-code-providers or ~/.claude-code-providers" >&2
    return 1
  fi

  echo "Synchronizing profiles with repository templates ($repo_dir)..."
  mkdir -p "$PROVIDERS_DIR"
  mkdir -p "$CLAUDE_DIR/providers_disabled"

  for obsolete in cmdc-space-bunny.json longcat.json u2flash.json unisound.json openrouter.json minmax.json; do
    if [ -f "$PROVIDERS_DIR/$obsolete" ]; then
      mv "$PROVIDERS_DIR/$obsolete" "$CLAUDE_DIR/providers_disabled/"
      echo -e "  \033[33m-- Archived obsolete profile $obsolete to ~/.claude/providers_disabled/\033[0m"
    fi
  done

  local added=0 reconciled=0
  for ex in "$repo_dir/providers"/*.json.example; do
    [ -f "$ex" ] || continue
    local base="$(basename "$ex" .example)"      # e.g. cmdc-vision.json
    local name="${base%.json}"                  # e.g. cmdc-vision
    if [ ! -f "$PROVIDERS_DIR/$base" ]; then
      cp "$ex" "$PROVIDERS_DIR/$base"
      echo -e "  \033[32m✔ Added new provider template: $base\033[0m"
      added=$((added + 1))
    else
      # Reconcile: refresh only the registry-derived context fields, keep
      # the user's own keys (tokens, extra settings) intact.
      reconcile_profile "$base" "$name" "$ex" && reconciled=$((reconciled + 1))
    fi
  done

  echo -e "\033[32m✔ Sync complete (added $added, reconciled $reconciled). Active providers:\033[0m"
  list_providers
}

# Merge registry-derived context fields from a template into a live profile,
# preserving the user's secrets and custom keys. Backs up before writing.
reconcile_profile() {
  local base="$1" name="$2" template="$3"
  local live="$PROVIDERS_DIR/$base"
  [ -f "$live" ] || return 1

  if ! command -v jq >/dev/null 2>&1; then
    return 1
  fi

  # Only proceed if a derived field actually changed.
  local new_ctx new_model cur_ctx cur_model
  new_ctx=$(jq -r '.env.CLAUDE_CODE_MAX_CONTEXT_TOKENS // empty' "$template")
  new_model=$(jq -r '.env.ANTHROPIC_MODEL // empty' "$template")
  cur_ctx=$(jq -r '.env.CLAUDE_CODE_MAX_CONTEXT_TOKENS // empty' "$live")
  cur_model=$(jq -r '.env.ANTHROPIC_MODEL // empty' "$live")
  if [ "$new_ctx" = "$cur_ctx" ] && [ "$new_model" = "$cur_model" ]; then
    return 1
  fi

  cp "$live" "$live.bak.$(date +%Y%m%d-%H%M%S)"
  local tmp
  tmp=$(mktemp)
  # take template, then re-apply any user credential overrides
  # (match credential keys exactly: AUTH_TOKEN / API_KEY — NOT *_TOKENS counts)
  if jq -s '.[0] * {env: (.[0].env * (.[1].env | with_entries(select(.key|test("AUTH_TOKEN$|_API_KEY$")))))}' \
       "$template" "$live" > "$tmp" 2>/dev/null && mv "$tmp" "$live"; then
    echo -e "  \033[33m~ Reconciled $name (ctx $cur_ctx -> $new_ctx)\033[0m"
    return 0
  fi
  rm -f "$tmp"
  echo -e "  \033[31m! Failed to reconcile $name (jq error)\033[0m" >&2
  return 1
}

test_provider() {
  local name="${1:-}"
  if [ -n "$name" ]; then
    switch_provider "$name"
  fi
  local cur_url
  cur_url=$(get_current_url)
  if [[ "$cur_url" =~ (127\.0\.0\.1|localhost):4000 ]]; then
    ensure_bridge_running "$cur_url"
  fi
  echo "Testing provider with 'claude -p \"say pong\"'..."
  claude -p "say pong"
}

switch_provider() {
  local arg1="$1"
  local arg2="${2:-}"

  # `ccp trae/kimi-k3` is the folder-path spelling of `ccp trae kimi-k3`.
  local provider="$arg1" model="$arg2"
  case "$arg1" in
    */*) provider="${arg1%%/*}"; model="${arg1#*/}" ;;
  esac

  local repo_dir py
  repo_dir=$(ccp_repo_dir)
  if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_pick.py" ]; then
    echo -e "\033[31mError: repo checkout not found (need bridge/ccp_pick.py).\033[0m" >&2
    return 1
  fi
  py=$(ccp_python)

  # Resolve BEFORE touching settings.json: a typo must not leave the session
  # pointed at a model that does not exist.
  local resolved
  if ! resolved=$("$py" "$repo_dir/bridge/ccp_pick.py" resolve "$provider" "$model" 2>&1); then
    echo -e "\033[31m$resolved\033[0m" >&2
    return 1
  fi
  local wire_model wire_ctx
  wire_model=$(printf '%s\n' "$resolved" | sed -n 's/^MODEL=//p')
  wire_ctx=$(printf '%s\n' "$resolved" | sed -n 's/^CTX=//p')

  local src="$PROVIDERS_DIR/$provider.json"
  if [ ! -r "$src" ]; then
    echo -e "\033[31mError: no installed profile for provider '$provider'.\033[0m" >&2
    echo "Run 'ccp sync' to install the profiles, then retry." >&2
    return 1
  fi

  mkdir -p "$CLAUDE_DIR"
  if [ -f "$SETTINGS_FILE" ]; then
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.bak.$(date +%Y%m%d-%H%M%S)"
  fi

  # Always install the provider profile first — it carries the base URL, the
  # tier fallbacks and the credentials. Only the model line is overridden
  # afterwards, otherwise switching to `trae kimi-k3` from a qianfan session
  # would keep qianfan's URL.
  cp "$src" "$SETTINGS_FILE"
  if [ -n "$model" ]; then
    set_active_model "$wire_model" "$wire_ctx" >/dev/null
  fi

  local target_url
  target_url=$(grep -oE '"ANTHROPIC_BASE_URL"[^,]*' "$src" 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' | head -1)
  [ -n "$target_url" ] && ensure_bridge_running "$target_url"

  echo -e "\033[32m✔ $provider → $wire_model\033[0m"
  echo "Restart any active 'claude' interactive sessions to take effect."
  list_provider_models "$provider"
}

main() {
  case "${1:-}" in
    "")
      list_providers
      ;;
    -h|--help|help)
      show_help
      ;;
    -c|--current|current)
      show_current
      ;;
    -r|--rollback|rollback)
      rollback_backup "${2:-1}"
      ;;
    -m|--model|model)
      set_active_model "${2:-}"
      ;;
    -t|--test|test)
      test_provider "${2:-}"
      ;;
    bridge)
      manage_bridge "${2:-status}"
      ;;
    auth)
      # Forward every argument: `ccp auth codebuddy --status` must reach the
      # helper, not be trimmed to the provider name.
      auth_provider "${@:2}"
      ;;
    accounts|account)
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_accounts.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/ccp_accounts.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)
      "$py_bin" "$repo_dir/bridge/ccp_accounts.py" "${@:2}"
      ;;
    quota|--quota)
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_quota.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/ccp_quota.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)
      "$py_bin" "$repo_dir/bridge/ccp_quota.py" "${@:2}"
      ;;
    ping|probe|speed)
      local repo_dir py_bin
      repo_dir=$(ccp_repo_dir)
      if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/bridge/ccp_probe.py" ]; then
        echo -e "\033[31mError: repo checkout not found (need bridge/ccp_probe.py).\033[0m" >&2
        return 1
      fi
      py_bin=$(ccp_python)

      local is_json=false
      local do_switch=false
      for arg in "$@"; do
        if [ "$arg" = "--json" ]; then
          is_json=true
        elif [ "$arg" = "--switch" ] || [ "$arg" = "-s" ]; then
          do_switch=true
        fi
      done

      if [ "$is_json" = false ]; then
        ensure_bridge_running "http://127.0.0.1:4000" >&2
      fi

      if [ "$do_switch" = true ]; then
        local tmp
        tmp=$(mktemp)
        "$py_bin" "$repo_dir/bridge/ccp_probe.py" "${@:2}" | tee "$tmp"
        local exit_code="${PIPESTATUS[0]}"
        local switch_target
        switch_target=$(grep -E '^SWITCH_TO=' "$tmp" | tail -1 | sed 's/^SWITCH_TO=//')
        rm -f "$tmp"
        if [ -n "$switch_target" ]; then
          case "$switch_target" in
            MODEL\ *)
              local m="${switch_target#MODEL }"
              echo -e "\n\033[32mSwitching active model to: $m\033[0m"
              set_active_model "$m"
              ;;
            *)
              echo -e "\n\033[32mSwitching provider to recommended winner: $switch_target\033[0m"
              switch_provider $switch_target
              ;;
          esac
        fi
        return "$exit_code"
      else
        "$py_bin" "$repo_dir/bridge/ccp_probe.py" "${@:2}"
      fi
      ;;
    models|--models)
      show_models "${2:-}"
      ;;
    render|--render)
      render_registry "${@:2}"
      ;;
    discover|--discover)
      discover_models "${@:2}"
      ;;
    sync|--sync)
      sync_providers
      ;;
    *)
      switch_provider "$1" "${2:-}"
      ;;
  esac
}

main "$@"
