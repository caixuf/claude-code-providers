{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "YOUR_LONGCAT_API_KEY",
    "ANTHROPIC_BASE_URL": "https://api.longcat.chat/anthropic",
    "ANTHROPIC_MODEL": "LongCat-2.5-Preview",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "LongCat-2.5-Preview",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "LongCat-2.5-Preview",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "LongCat-2.0",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "LongCat-2.0",
    "ANTHROPIC_SMALL_FAST_MODEL": "LongCat-2.0",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  },
  "permissions": { "defaultMode": "bypassPermissions" },
  "model": "LongCat-2.5-Preview",
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
