{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "sk-cmdc-litellm-local",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
    "ANTHROPIC_MODEL": "cmdc-deepseek",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "cmdc-deepseek",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "cmdc-deepseek",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "cmdc-deepseek",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "cmdc-deepseek",
    "ANTHROPIC_SMALL_FAST_MODEL": "cmdc-deepseek",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "128000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "128000"
  },
  "permissions": { "defaultMode": "bypassPermissions" },
  "model": "cmdc-deepseek",
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
