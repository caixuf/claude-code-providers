{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "sk-cmdc-litellm-local",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
    "ANTHROPIC_MODEL": "deepseek/deepseek-v4.1-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "cmdc-deepseek-pro",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "cmdc-deepseek-pro",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek/deepseek-v4.1-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "cmdc-deepseek-fast",
    "ANTHROPIC_SMALL_FAST_MODEL": "cmdc-deepseek-fast",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "deepseek/deepseek-v4.1-flash",
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}