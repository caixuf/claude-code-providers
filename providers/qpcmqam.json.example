{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "sk-ccp-litellm-local",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
    "ANTHROPIC_MODEL": "qpcmqam-gpt-6.1-terra",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "qpcmqam-gpt-6.1-terra",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "qpcmqam-gpt-6.1-terra",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "qpcmqam-gpt-6.1-terra",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "qpcmqam-gpt-6.1-terra",
    "ANTHROPIC_SMALL_FAST_MODEL": "qpcmqam-gpt-6.1-terra",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "272000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "272000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
