{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "YOUR_TRAE_API_KEY",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4100",
    "ANTHROPIC_MODEL": "qwen3.8-max",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "Doubao-Seed-2.1-pro",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "Doubao-Seed-2.1-pro",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "qwen3.8-max",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash",
    "ANTHROPIC_SMALL_FAST_MODEL": "glm-5.3-flash",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "168000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "168000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "qwen3.8-max",
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
