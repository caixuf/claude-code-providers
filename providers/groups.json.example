{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "sk-ccp-litellm-local",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
    "ANTHROPIC_MODEL": "main[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "pro",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "main[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "main[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "flash[1m]",
    "ANTHROPIC_SMALL_FAST_MODEL": "flash[1m]",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "main[1m]",
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
