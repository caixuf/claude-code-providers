{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "YOUR_UNISOUND_API_KEY",
    "ANTHROPIC_BASE_URL": "https://maas-api.unisound.com/anthropic",
    "ANTHROPIC_MODEL": "u2-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "u2-flash",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "u2-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "u2-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "u2-flash",
    "ANTHROPIC_SMALL_FAST_MODEL": "u2-flash",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "512000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "512000"
  },
  "permissions": { "defaultMode": "bypassPermissions" },
  "model": "u2-flash",
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
