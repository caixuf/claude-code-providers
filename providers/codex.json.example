{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "YOUR_CODEX_API_KEY",
    "ANTHROPIC_BASE_URL": "http://localhost:56895/v1",
    "ANTHROPIC_MODEL": "gpt-6.1-sol",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-6-astra",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "gpt-6.1-sol",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-6-luna",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gpt-5.6-luna",
    "ANTHROPIC_SMALL_FAST_MODEL": "gpt-5.6-luna",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "272000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "272000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "gpt-6.1-sol",
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
